-- The duel: two fighters in real time, 60 frames a second, on the move cards' frame data. A fighter starts a
-- move when its controller asks for one that its stance allows and its stamina pays for (the AI asks with the
-- same buttons a player presses); the move runs its startup, active and recovery frames. At an attack's first
-- active frame it meets whatever the defender is doing and the combat kernel (stdlib/combat.card) decides:
-- align, timing_class, outcome, damage_through, block_posture, attacker_posture, recoil_frames, redirect_bank,
-- flow_startup, banked_damage. The same rules for both sides; nothing here knows who is human.
const PX = 16
const ARENA_L = 36
const ARENA_R = 444
const GROUND = 216
const BAND_CLOSE = 46
const BAND_MID = 92
const WALK_FWD = 22
const WALK_BACK = 18
const STEP_PX = 34
const LUNGE_PX = 22
const MIN_GAP = 22
const ROUND_FRAMES = 3600
const ROUNDS_TO_WIN = 2
const HITSTOP = 5
const BROKEN_FRAMES = 72
const RECOIL_STANCE = 30
const BUFFER = 6
const BANK_MAX = 100
const INTRO = 100
const OUTRO = 150

array f_x: Int[2]
array f_face: Int[2]
array f_ft: Int[2]
array f_ctl: Int[2]
array f_hp: Int[2]
array f_hpmax: Int[2]
array f_post: Int[2]
array f_postmax: Int[2]
array f_stam: Int[2]
array f_stammax: Int[2]
array f_stance: Int[2]
array f_stance_t: Int[2]
array f_move: Int[2]
array f_t: Int[2]
array f_start: Int[2]
array f_len: Int[2]
array f_resolved: Int[2]
array f_up_at: Int[2]
array f_stun: Int[2]
array f_stun_kind: Int[2]
array f_bank: Int[2]
array f_resid: Int[2]
array f_last_dir: Int[2]
array f_shown: Int[2]
array f_feinted: Int[2]
array f_walk: Int[2]
array f_anim: Int[2]
array f_flash: Int[2]
array f_buf: Int[2]
array f_buf_t: Int[2]
array f_idle_t: Int[2]
array f_hit_t: Int[2]
array f_rounds: Int[2]
array f_dmg_round: Int[2]
array f_last_outcome: Int[2]
array f_bits: Int[2]
array f_press: Int[2]
array f_prevbits: Int[2]
array st_redirects: Int[2]
array st_deflects: Int[2]
array st_hits: Int[2]
array st_evades: Int[2]
array st_feint_hits: Int[2]
array st_breaks: Int[2]

global duel_t: Int = 0
global round_no: Int = 1
global round_state: Int = 0
global round_t: Int = 0
global hitstop: Int = 0
global slowmo: Int = 0
global round_winner: Int = -1
global duel_winner: Int = -1
global training: Int = 0
global versus: Int = 0
global flawless: Int = 0
global flash_t: Int = 0
global boss_phase: Int = 0
global p1_last: Int = -1
global p1_last_start: Int = 0
global flash_col: Int = 0xFFFFFF

-- what the screen shows of the last exchange: a word, where, how long, what colour
global ev_text: Int = -1
global ev_t: Int = 0
global ev_x: Int = 0
global ev_col: Int = 0xFFFFFF
global ev_big: Int = 0
-- the last impact (for sparks and the training read-out)
global hit_x: Int = 0
global hit_y: Int = 0
global hit_kind: Int = -1
global hit_t: Int = 99
global last_move: Int = -1

fn other(i: Int) -> Int = 1 - i
fn xpx(i: Int) -> Int = f_x[i] // PX
fn gap() -> Int = abs(xpx(0) - xpx(1))
fn band() -> Int {
  let d = gap()
  if d < BAND_CLOSE {
    return 0
  }
  if d < BAND_MID {
    return 1
  }
  return 2
}
fn has_move(i: Int, m: Int) -> Bool = ((ft_moves[f_ft[i]] >> m) & 1) != 0
fn kind_of(i: Int) -> Int = if f_move[i] < 0 then K_NONE else mv_kind[f_move[i]]
fn idle(i: Int) -> Bool = f_move[i] < 0 and f_stun[i] <= 0
fn attacking(i: Int) -> Bool {
  let k = kind_of(i)
  return k == K_ATTACK or k == K_GRAB or k == K_FEINT
}
-- before its impact: the tell is showing
fn in_startup(i: Int) -> Bool = attacking(i) and f_t[i] < f_start[i]
fn guard_up(i: Int) -> Bool = kind_of(i) == K_GUARD and f_up_at[i] >= 0

fn event(s: Int, x: Int, col: Int, big: Int) {
  ev_text = s
  ev_t = 0
  ev_x = x
  ev_col = col
  ev_big = big
}

fn duel_setup(ft0: Int, ctl0: Int, ft1: Int, ctl1: Int) {
  f_ft[0] = ft0
  f_ft[1] = ft1
  f_ctl[0] = ctl0
  f_ctl[1] = ctl1
  for i in 0 .. 2 {
    f_rounds[i] = 0
    st_redirects[i] = 0
    st_deflects[i] = 0
    st_hits[i] = 0
    st_evades[i] = 0
    st_feint_hits[i] = 0
    st_breaks[i] = 0
  }
  round_no = 1
  duel_winner = -1
  ai_duel_setup()
  round_setup()
}
fn round_setup() {
  for i in 0 .. 2 {
    let ft = f_ft[i]
    f_hpmax[i] = ft_hp[ft]
    f_hp[i] = ft_hp[ft]
    f_postmax[i] = ft_posture[ft]
    f_post[i] = 0
    f_stammax[i] = ft_stamina[ft]
    f_stam[i] = ft_stamina[ft]
    f_stance[i] = ST_NEUTRAL
    f_stance_t[i] = 0
    f_move[i] = -1
    f_t[i] = 0
    f_stun[i] = 0
    f_bank[i] = 0
    f_resid[i] = 0
    f_last_dir[i] = NO_DIR
    f_shown[i] = NO_DIR
    f_up_at[i] = -1
    f_walk[i] = 0
    f_flash[i] = 0
    f_buf[i] = 0
    f_idle_t[i] = 0
    f_hit_t[i] = 99
    f_dmg_round[i] = 0
    f_last_outcome[i] = -1
    f_prevbits[i] = 0
  }
  f_x[0] = 168 * PX
  f_x[1] = 312 * PX
  f_face[0] = 1
  f_face[1] = -1
  duel_t = 0
  round_state = 0
  round_t = 0
  hitstop = 0
  slowmo = 0
  round_winner = -1
  ev_text = -1
  hit_kind = -1
  if boss_phase != 0 {
    ai_level[1] = max(1, ai_level[1] - 2)
  }
  boss_phase = 0
  ai_round_setup()
}

-- buttons to a move ----------------------------------------------------------------------------------------------
-- the vector the direction buttons point: right 0, up 2, left 4, down 6, diagonals between, nothing 9
fn dir_of(bits: Int) -> Int {
  let u = (bits & B_UP) != 0
  let d = (bits & B_DOWN) != 0
  let l = (bits & B_LEFT) != 0
  let r = (bits & B_RIGHT) != 0
  if u and r {
    return 1
  }
  if u and l {
    return 3
  }
  if d and l {
    return 5
  }
  if d and r {
    return 7
  }
  if r {
    return 0
  }
  if u {
    return 2
  }
  if l {
    return 4
  }
  if d {
    return 6
  }
  return NO_DIR
}
-- forward / back from the direction buttons, relative to facing
fn walk_of(i: Int, bits: Int) -> Int {
  let l = (bits & B_LEFT) != 0
  let r = (bits & B_RIGHT) != 0
  if l == r {
    return 0
  }
  if r {
    return f_face[i]
  }
  return -f_face[i]
}
fn pick(i: Int, m: Int) -> Int = if has_move(i, m) then m else -1
fn guard_for(i: Int, d: Int) -> Int {
  if d == 0 or d == 7 {
    return pick(i, MV_GUARD_RIGHT)
  }
  if d == 2 or d == 1 {
    return pick(i, MV_GUARD_HIGH)
  }
  if d == 4 or d == 3 {
    return pick(i, MV_GUARD_LEFT)
  }
  if d == 6 or d == 5 {
    return pick(i, MV_GUARD_LOW)
  }
  return pick(i, MV_GUARD_CENTER)
}
fn attack_for(i: Int, d: Int) -> Int {
  if d == 0 {
    return pick(i, MV_SLASH_RIGHT)
  }
  if d == 4 {
    return pick(i, MV_SLASH_LEFT)
  }
  if d == 2 {
    let m = pick(i, MV_OVERHEAD)
    return if m >= 0 then m else pick(i, MV_DIAGONAL)
  }
  if d == 6 {
    return pick(i, MV_RISING)
  }
  if d == 1 or d == 3 or d == 5 or d == 7 {
    return pick(i, MV_DIAGONAL)
  }
  return pick(i, MV_THRUST)
}
fn heavy_for(i: Int, d: Int, fwd: Int) -> Int {
  if d == 2 or d == 1 or d == 3 {
    return pick(i, MV_HEAVY_OVERHEAD)
  }
  if d == 6 or d == 5 or d == 7 {
    return pick(i, MV_SWEEP)
  }
  if fwd != 0 {
    return pick(i, MV_GRAB)
  }
  return pick(i, MV_JAB)
}
fn evade_for(i: Int, d: Int, fwd: Int) -> Int {
  if d == 2 or d == 1 or d == 3 {
    return pick(i, MV_JUMP)
  }
  if d == 6 or d == 5 or d == 7 {
    return pick(i, MV_DUCK)
  }
  if fwd > 0 {
    return pick(i, MV_SIDESTEP)
  }
  if fwd < 0 {
    return pick(i, MV_BACKSTEP)
  }
  return pick(i, MV_ROLL)
}
-- the move a press asks for (-1: none)
fn wanted(i: Int, bits: Int, press: Int) -> Int {
  let d = dir_of(bits)
  let fwd = walk_of(i, bits)
  if (press & B_EVADE) != 0 {
    return evade_for(i, d, fwd)
  }
  if (press & B_CATCH) != 0 {
    return pick(i, MV_STEP_IN)
  }
  if (press & B_FEINT) != 0 {
    return pick(i, MV_FEINT_OVERHEAD)
  }
  if (press & B_HEAVY) != 0 {
    return heavy_for(i, d, fwd)
  }
  if (press & B_ATTACK) != 0 {
    return attack_for(i, d)
  }
  return -1
}

fn allowed(i: Int, m: Int) -> Bool {
  if m < 0 or not has_move(i, m) {
    return false
  }
  if ((mv_from[m] >> f_stance[i]) & 1) == 0 {
    return false
  }
  return f_stam[i] >= mv_stamina[m]
}
fn start_move(i: Int, m: Int) {
  f_move[i] = m
  f_t[i] = 0
  f_resolved[i] = 0
  f_up_at[i] = -1
  f_feinted[i] = 0
  f_stam[i] -= mv_stamina[m]
  f_idle_t[i] = 0
  let k = mv_kind[m]
  var s = max(1, mv_startup[m])
  if (k == K_ATTACK or k == K_FEINT) and mv_dir[m] != NO_DIR {
    s = flow_startup(max(1, mv_startup[m]), min(100, f_resid[i]), f_last_dir[i], mv_dir[m])
  }
  f_start[i] = s
  f_len[i] = s + mv_active[m] + mv_recovery[m]
  f_shown[i] = mv_dir[m]
  last_move = m
  if i == 0 {
    p1_last = m
    p1_last_start = s
  }
  if k == K_ATTACK or k == K_GRAB or k == K_FEINT {
    ai_saw_attack(other(i), m)
    sfx(SFX_WINDUP)
  } elif k == K_GUARD {
    ai_saw_guard(other(i), mv_dir[m])
  } elif k == K_EVADE or k == K_STEP or k == K_CATCH {
    sfx(SFX_STEP)
  }
}
-- a move's own motion: steps and evades travel, attacks lunge into reach
fn move_motion(i: Int) {
  let m = f_move[i]
  let k = mv_kind[m]
  if (k == K_STEP or k == K_EVADE or k == K_CATCH) and mv_move[m] != 0 {
    let span = max(1, f_start[i] + mv_recovery[m] // 2)
    if f_t[i] < span {
      f_x[i] -= f_face[i] * mv_move[m] * STEP_PX * PX // span
    }
  }
  if (k == K_ATTACK or k == K_GRAB) and mv_lunge[m] > 0 and f_t[i] < f_start[i] and band() > mv_reach_hi[m] {
    f_x[i] += f_face[i] * mv_lunge[m] * LUNGE_PX * PX // max(1, f_start[i])
  }
}

-- the impact -------------------------------------------------------------------------------------------------------
fn hp_damage(j: Int, dmg: Int) {
  let d = max(0, dmg)
  f_hp[j] = max(0, f_hp[j] - d)
  f_dmg_round[j] += d
  if f_ctl[j] == AI_BOSS and boss_phase == 0 and f_hp[j] > 0 and f_hp[j] * 2 < f_hpmax[j] {
    -- the Architect adapts: sharper reads, a clear posture
    boss_phase = 1
    ai_level[j] = min(9, ai_level[j] + 2)
    f_post[j] = 0
    event(S_ADAPTS, xpx(j), 0xC77DFF, 1)
    flash_t = 8
    flash_col = 0xC77DFF
    sfx(SFX_BREAK)
  }
  if training != 0 and j == 1 {
    f_hp[j] = max(f_hp[j], 1)
  }
}
fn posture_damage(j: Int, p: Int) {
  if f_stance[j] == ST_BROKEN {
    return
  }
  f_post[j] += max(0, p)
  if f_post[j] >= f_postmax[j] {
    f_post[j] = f_postmax[j]
    f_stance[j] = ST_BROKEN
    f_stance_t[j] = 0
    f_move[j] = -1
    f_stun[j] = BROKEN_FRAMES
    f_stun_kind[j] = 2
    st_breaks[other(j)] += 1
    event(S_BROKEN, xpx(j), 0xFFC040, 1)
    sfx(SFX_BREAK)
    achievement_progress_break(other(j))
  }
}
fn recoil(i: Int, frames: Int) {
  f_move[i] = -1
  f_stun[i] = max(f_stun[i], frames)
  f_stun_kind[i] = 1
  f_stance[i] = ST_RECOIL
  f_stance_t[i] = 0
}
fn push(i: Int, px_away: Int) {
  f_x[i] -= f_face[i] * px_away * PX
}
fn mark_hit(i: Int, j: Int, kind: Int) {
  hit_x = (xpx(0) + xpx(1)) // 2
  hit_y = GROUND - 44
  hit_kind = kind
  hit_t = 0
  f_last_outcome[j] = kind
}
fn land(i: Int, j: Int, m: Int, scale_pct: Int) {
  var dmg = banked_damage(mv_damage[m], min(BANK_MAX, f_bank[i]))
  f_bank[i] = 0
  var crit = false
  if f_stance[j] == ST_BROKEN {
    dmg = dmg * 2
    crit = true
    f_stance[j] = ST_NEUTRAL
    f_post[j] = 0
    f_stun[j] = 0
  }
  dmg = dmg * scale_pct // 100
  let dm = f_move[j]
  let armoured = dm >= 0 and mv_poise[dm] > 0 and f_t[j] < f_start[j] and dmg <= mv_poise[dm] * 2
  let counter = dm >= 0 and in_startup(j)
  hp_damage(j, dmg)
  st_hits[i] += 1
  if f_feinted[i] != 0 {
    st_feint_hits[i] += 1
    achievement_progress_feint(i)
  }
  f_flash[j] = 8
  f_hit_t[j] = 0
  hitstop = HITSTOP + min(6, dmg // 8)
  shake(2 + min(4, dmg // 10))
  if not armoured {
    f_move[j] = -1
    f_stun[j] = 10 + dmg // 3
    f_stun_kind[j] = 0
    push(j, if dmg >= 25 then 16 else 6 + dmg // 6)
  }
  posture_damage(j, mv_posture[m])
  mark_hit(i, j, 0)
  if crit {
    event(S_CRITICAL, xpx(j), 0xFF4040, 1)
    sfx(SFX_HEAVY_HIT)
  } elif mv_kind[m] == K_GRAB {
    event(S_GRABBED, xpx(j), 0xFFA040, 0)
    sfx(SFX_HIT)
  } elif counter {
    event(S_COUNTER, xpx(j), 0xFF8040, 0)
    sfx(SFX_HEAVY_HIT)
  } elif f_feinted[i] != 0 {
    event(S_FEINT, xpx(j), 0xFF80FF, 0)
    sfx(SFX_HIT)
  } else {
    event(S_HIT, xpx(j), 0xFFFFFF, 0)
    sfx(if dmg >= 25 then SFX_HEAVY_HIT else SFX_HIT)
  }
}
fn impact(i: Int) {
  let j = other(i)
  let m = f_move[i]
  let b = band()
  if b < mv_reach_lo[m] or b > mv_reach_hi[m] + mv_lunge[m] {
    sfx(SFX_WHIFF)
    return
  }
  let dm = f_move[j]
  let dk = kind_of(j)
  let tags = mv_tags[m]
  let mom = min(100, mv_momentum[m])
  -- an evade inside its invincible frames slips what it slips, and banks the overextension
  if dk == K_EVADE and f_t[j] >= mv_if0[dm] and f_t[j] <= mv_if1[dm] and (mv_evades[dm] & tags) != 0 {
    if mv_bank_div[dm] > 0 {
      f_bank[j] = min(BANK_MAX, f_bank[j] + mom // mv_bank_div[dm])
    }
    st_evades[j] += 1
    mark_hit(i, j, 5)
    event(S_EVADED, xpx(j), 0x80E0FF, 0)
    sfx(SFX_WHIFF)
    achievement_progress_evade(j)
    return
  }
  -- a catch pins a linear attack
  if dk == K_CATCH and f_t[j] <= mv_startup[dm] + 8 and (tags & TAG_LINEAR) != 0 {
    posture_damage(i, attacker_posture(mom, 3))
    recoil(i, recoil_frames(mom, 3) + 10)
    mark_hit(i, j, 6)
    event(S_CAUGHT, xpx(i), 0x80FF80, 1)
    sfx(SFX_CLASH)
    return
  }
  -- a grab goes through guards
  if mv_kind[m] == K_GRAB {
    land(i, j, m, 100)
    return
  }
  if guard_up(j) {
    let delta = duel_t - f_up_at[j]
    let tc = timing_class(delta, mv_perfect[dm], mv_good[dm])
    let al = align(mv_dir[m], mv_dir[dm])
    let oc = outcome(al, tc)
    if oc == 4 {
      posture_damage(i, attacker_posture(mom, 4))
      if f_stance[i] != ST_BROKEN {
        recoil(i, recoil_frames(mom, 4))
      }
      f_bank[j] = min(BANK_MAX, f_bank[j] + redirect_bank(mom))
      st_redirects[j] += 1
      mark_hit(i, j, 4)
      event(S_REDIRECT, xpx(j), 0x40E0FF, 1)
      hitstop = 10
      slowmo = 24
      shake(3)
      flash_t = 6
      flash_col = 0xC0F8FF
      sfx(SFX_REDIRECT)
      achievement_progress_redirect(j)
      return
    }
    if oc == 3 {
      posture_damage(i, attacker_posture(mom, 3))
      if f_stance[i] != ST_BROKEN {
        recoil(i, recoil_frames(mom, 3))
      }
      st_deflects[j] += 1
      mark_hit(i, j, 3)
      event(S_DEFLECT, xpx(j), 0x60C0FF, 0)
      hitstop = 6
      sfx(SFX_CLASH)
      return
    }
    if oc == 2 {
      hp_damage(j, damage_through(mv_damage[m], 2, al))
      posture_damage(j, block_posture(mv_posture[m], max(0, al)))
      push(j, 4)
      mark_hit(i, j, 2)
      event(S_BLOCK, xpx(j), 0xC0C0C0, 0)
      hitstop = 3
      sfx(SFX_BLOCK)
      return
    }
    if oc == 1 {
      hp_damage(j, damage_through(mv_damage[m], 1, al))
      posture_damage(j, mv_posture[m])
      f_flash[j] = 6
      push(j, 6)
      mark_hit(i, j, 1)
      event(S_PIERCE, xpx(j), 0xFFA060, 0)
      hitstop = 4
      sfx(SFX_HIT)
      return
    }
  }
  land(i, j, m, 100)
}

-- one fighter's frame --------------------------------------------------------------------------------------------
fn fighter_frame(i: Int) {
  let bits = f_bits[i]
  let press = f_press[i]
  if press != 0 {
    f_buf[i] = press
    f_buf_t[i] = 0
  } else {
    f_buf_t[i] += 1
    if f_buf_t[i] > BUFFER {
      f_buf[i] = 0
    }
  }
  f_flash[i] = max(0, f_flash[i] - 1)
  f_hit_t[i] = min(99, f_hit_t[i] + 1)
  f_stance_t[i] += 1
  if f_stun[i] > 0 {
    f_stun[i] -= 1
    f_walk[i] = 0
    if f_stun[i] == 0 and f_stance[i] == ST_BROKEN {
      f_stance[i] = ST_NEUTRAL
      f_post[i] = 0
    }
    return
  }
  if f_stance[i] == ST_RECOIL and f_stance_t[i] > RECOIL_STANCE {
    f_stance[i] = ST_NEUTRAL
  }
  let m = f_move[i]
  if m >= 0 {
    let k = mv_kind[m]
    if k == K_GUARD {
      if f_t[i] == f_start[i] and f_up_at[i] < 0 {
        f_up_at[i] = duel_t
      }
      -- a held guard stays up; a new direction raises a fresh guard (a fresh timing)
      if f_up_at[i] >= 0 and (bits & B_GUARD) != 0 {
        let g = guard_for(i, dir_of(bits))
        if g >= 0 and g != m and allowed(i, g) {
          start_move(i, g)
          f_stam[i] += mv_stamina[g] - 1
        }
        return
      }
    }
    if k == K_FEINT and f_t[i] == f_start[i] and mv_into[m] >= 0 {
      -- the feint shows its tell, then becomes the move it hides
      let into = mv_into[m]
      start_move(i, into)
      f_stam[i] += mv_stamina[into]
      f_feinted[i] = 1
      sfx(SFX_FEINT)
      return
    }
    move_motion(i)
    if (k == K_ATTACK or k == K_GRAB) and f_t[i] == f_start[i] and f_resolved[i] == 0 {
      f_resolved[i] = 1
      sfx(SFX_SWING)
      impact(i)
      if f_move[i] < 0 {
        return
      }
    }
    f_t[i] += 1
    if f_t[i] >= f_len[i] {
      if k == K_ATTACK or k == K_GRAB {
        f_resid[i] = mv_momentum[m] // 2
        f_last_dir[i] = mv_dir[m]
      }
      f_stance[i] = mv_to[m]
      f_stance_t[i] = 0
      f_move[i] = -1
      f_up_at[i] = -1
    } else {
      return
    }
  }
  -- idle: a buffered press starts a move; a held guard raises one; otherwise walk
  f_idle_t[i] += 1
  if f_idle_t[i] % 4 == 0 and f_resid[i] > 0 {
    f_resid[i] -= 1
  }
  if f_idle_t[i] % 2 == 0 {
    f_stam[i] = min(f_stammax[i], f_stam[i] + 1)
  }
  if f_idle_t[i] > 40 and f_idle_t[i] % 6 == 0 {
    f_post[i] = max(0, f_post[i] - 1)
  }
  if f_stance[i] == ST_FLOW and f_stance_t[i] > 40 {
    f_stance[i] = ST_NEUTRAL
  }
  var want = -1
  if f_buf[i] != 0 {
    want = wanted(i, bits, f_buf[i])
  }
  if want < 0 and (bits & B_GUARD) != 0 {
    want = guard_for(i, dir_of(bits))
  }
  if want >= 0 and allowed(i, want) {
    f_buf[i] = 0
    f_walk[i] = 0
    start_move(i, want)
    return
  }
  let w = walk_of(i, bits)
  f_walk[i] = w
  if w != 0 {
    f_anim[i] += 1
    f_x[i] += f_face[i] * w * (if w > 0 then WALK_FWD else WALK_BACK)
  }
}
fn keep_apart() {
  let l = if f_x[0] <= f_x[1] then 0 else 1
  let r = 1 - l
  for i in 0 .. 2 {
    f_x[i] = max(ARENA_L * PX, min(ARENA_R * PX, f_x[i]))
  }
  if f_x[r] - f_x[l] < MIN_GAP * PX {
    let mid = (f_x[l] + f_x[r]) // 2
    f_x[l] = mid - MIN_GAP * PX // 2
    f_x[r] = mid + MIN_GAP * PX // 2
  }
  f_face[l] = 1
  f_face[r] = -1
}

-- the round ---------------------------------------------------------------------------------------------------------
fn controls(i: Int) -> Int {
  let c = f_ctl[i]
  if c == AI_HUMAN {
    return if i == 0 then held1 else held2
  }
  return ai_bits(i)
}
fn end_round(w: Int, s: Int) {
  round_state = 2
  round_t = 0
  round_winner = w
  if w >= 0 {
    f_rounds[w] += 1
    if f_ctl[w] == AI_HUMAN and versus == 0 {
      achievement_round_won(w, f_dmg_round[w] == 0)
    }
  }
  event(s, 240, 0xFFE070, 1)
  sfx(if s == S_KO then SFX_KO else SFX_BELL)
  if s == S_KO {
    flash_t = 10
    flash_col = 0xFFFFFF
    shake(6)
  }
}
fn duel_update() {
  if ev_text >= 0 {
    ev_t += 1
    if ev_t > 70 {
      ev_text = -1
    }
  }
  hit_t = min(99, hit_t + 1)
  flash_t = max(0, flash_t - 1)
  shake_decay()
  round_t += 1
  if round_state == 0 {
    if round_t == 1 {
      sfx(SFX_BELL)
    }
    if round_t >= INTRO {
      round_state = 1
      round_t = 0
      event(S_FIGHT, 240, 0xFFFFFF, 1)
    }
    return
  }
  if round_state == 2 {
    if round_t >= OUTRO {
      if f_rounds[0] >= ROUNDS_TO_WIN or f_rounds[1] >= ROUNDS_TO_WIN {
        duel_winner = if f_rounds[0] > f_rounds[1] then 0 else 1
      } else {
        round_no += 1
        round_setup()
      }
    }
    return
  }
  if hitstop > 0 {
    hitstop -= 1
    return
  }
  if slowmo > 0 {
    slowmo -= 1
    if slowmo % 2 == 1 {
      return
    }
  }
  for i in 0 .. 2 {
    let b = controls(i)
    f_press[i] = b & (~f_prevbits[i])
    f_prevbits[i] = b
    f_bits[i] = b
  }
  -- both act on the same frame: their impacts are judged against what the other was doing at that frame
  fighter_frame(0)
  fighter_frame(1)
  keep_apart()
  duel_t += 1
  if training != 0 {
    f_hp[1] = max(f_hp[1], 1)
    if f_hit_t[1] > 90 {
      f_hp[1] = min(f_hpmax[1], f_hp[1] + 2)
    }
    f_hp[0] = max(f_hp[0], 1)
    return
  }
  if f_hp[0] <= 0 or f_hp[1] <= 0 {
    if f_hp[0] <= 0 and f_hp[1] <= 0 {
      end_round(-1, S_KO)
    } else {
      end_round(if f_hp[0] <= 0 then 1 else 0, S_KO)
    }
    return
  }
  if duel_t >= ROUND_FRAMES {
    let a = f_hp[0] * 1000 // f_hpmax[0]
    let b = f_hp[1] * 1000 // f_hpmax[1]
    end_round(if a == b then -1 else if a > b then 0 else 1, S_TIME)
  }
}
fn seconds_left() -> Int = max(0, (ROUND_FRAMES - duel_t + 59) // 60)
