-- Game Boy Color registers: KEY1 (FF4D, the double-speed switch armed by bit 0 and done by STOP), VBK (FF4F,
-- VRAM bank), HDMA (FF51-FF55), BCPS/BCPD and OCPS/OCPD (FF68-FF6B: 8 background and 8 object palettes of four
-- RGB555 colours, auto-incrementing index), OPRI (FF6C), SVBK (FF70: WRAM bank 1-7 at D000), the undocumented
-- FF72-FF75. In DMG mode they read 0xFF and ignore writes.
const SPEED_SWITCH_MCYCLES = 2050
global key1: Int = 0
global svbk: Int = 0
global ff72: Int = 0
global ff73: Int = 0
global ff74: Int = 0
global ff75: Int = 0

fn cgb_read(r: Int) -> Int {
  if cgb == 0 {
    return 0xFF
  }
  if r == 0x4D {
    return 0x7E | (ds << 7) | (key1 & 1)
  }
  if r == 0x4F {
    return 0xFE | vbk
  }
  if r == 0x55 {
    return hdma_read()
  }
  if r == 0x68 {
    return 0x40 | bcps
  }
  if r == 0x69 {
    return bgpal[bcps & 0x3F]
  }
  if r == 0x6A {
    return 0x40 | ocps
  }
  if r == 0x6B {
    return obpal[ocps & 0x3F]
  }
  if r == 0x6C {
    return 0xFE | opri
  }
  if r == 0x70 {
    return 0xF8 | svbk
  }
  if r == 0x72 {
    return ff72
  }
  if r == 0x73 {
    return ff73
  }
  if r == 0x74 {
    return ff74
  }
  if r == 0x75 {
    return 0x8F | ff75
  }
  if r == 0x76 {
    return apu_pcm12()
  }
  if r == 0x77 {
    return apu_pcm34()
  }
  return 0xFF
}
fn cgb_write(r: Int, v: Int) {
  if cgb == 0 {
    return
  }
  if r == 0x4D {
    key1 = v & 1
  } elif r == 0x4F {
    vbk = v & 1
  } elif r >= 0x51 and r <= 0x55 {
    hdma_write(r, v)
  } elif r == 0x68 {
    bcps = v & 0xBF
  } elif r == 0x69 {
    bgpal[bcps & 0x3F] = v
    if (bcps & 0x80) != 0 {
      bcps = 0x80 | ((bcps + 1) & 0x3F)
    }
  } elif r == 0x6A {
    ocps = v & 0xBF
  } elif r == 0x6B {
    obpal[ocps & 0x3F] = v
    if (ocps & 0x80) != 0 {
      ocps = 0x80 | ((ocps + 1) & 0x3F)
    }
  } elif r == 0x6C {
    opri = v & 1
  } elif r == 0x70 {
    svbk = v & 7
    wram_bank = if svbk == 0 then 1 else svbk
  } elif r == 0x72 {
    ff72 = v
  } elif r == 0x73 {
    ff73 = v
  } elif r == 0x74 {
    ff74 = v
  } elif r == 0x75 {
    ff75 = v & 0x70
  }
}
-- STOP: the CGB speed switch when KEY1 bit 0 is armed, else stop mode until a button is pressed
fn stop() {
  if cgb != 0 and (key1 & 1) != 0 {
    full_sync()
    ds = ds ^ 1
    md = 4 >> ds
    key1 = 0
    now += SPEED_SWITCH_MCYCLES * md
    next_event = now
  } else {
    stopped = 1
  }
}
