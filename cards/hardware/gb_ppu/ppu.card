-- The PPU (LCD controller). A frame is 154 lines of 456 dots (70224 dots). Visible lines 0-143 go through mode 2
-- (OAM scan, 80 dots), mode 3 (drawing, 172 dots + penalties for SCX and sprites) and mode 0 (H-blank, the rest);
-- lines 144-153 are mode 1 (V-blank, requested at the start of line 144). STAT requests an interrupt on the
-- rising edge of (LY=LYC and bit 6) or (mode 0 and bit 3) or (mode 1 and bit 4) or (mode 2 and bit 5).
-- A line is drawn when mode 3 ends, from the registers as they are then (a scanline renderer: changes made in
-- the middle of mode 3 apply to the whole line). DMG shades and CGB colours (RGB555) both end as RGB888 in
-- `frame`. VRAM is blocked in mode 3 and OAM in modes 2 and 3 while the LCD is on.
--
-- What the CPU sees lags the PPU's own transitions by a dot, so an access at the start of an M-cycle sees a
-- change only from the next one (mooneye lcdon_timing, intr_2_mode3/mode0/oam_ok_timing): on a line starting
-- at L (LY changes, the mode 2 interrupt), STAT shows mode 0 and no LY=LYC match at L, mode 2 until L+80, mode
-- 3 until mode 3 has ended; OAM is blocked from L, VRAM from L+80, both until then. Writes land later in their
-- M-cycle: an OAM write passes at L and at L+80, a VRAM write at L+80 (mooneye lcdon_write_timing). The first
-- line after the LCD is switched on starts 4 dots short, in mode 0 (no OAM scan), with OAM and VRAM open
-- until mode 3. Objects lengthen mode 3 as Pan Docs measures it (mooneye intr_2_mode0_timing_sprites).
const DOTS_PER_LINE = 456
const LINES = 154
const MODE2_DOTS = 80
const MODE3_DOTS = 172
const VIEW_LAG = 1               -- dots the CPU's view of a mode change lags it
const LCDON_SHORT = 4            -- the first line after LCD enable is this much shorter
const OBJ_FETCH_DOTS = 6
const SCREEN_W = 160
const SCREEN_H = 144
global lcdc: Int = 0x91
global stat_sel: Int = 0
global ly: Int = 0
global lyc: Int = 0
global scy: Int = 0
global scx: Int = 0
global wy: Int = 0
global wx: Int = 0
global bgp: Int = 0xFC
global obp0: Int = 0xFF
global obp1: Int = 0xFF
global mode: Int = 2
global ppu_next: Int = 80
global line_start: Int = 0
global mode3_len: Int = 172
global first_line: Int = 0       -- 1: the first line after LCD enable, before mode 3; 2: after
global vblank_m2: Int = 0        -- the instant line 144 begins, which also counts as a mode 2 (OAM) event
global lyc_latched: Int = 0      -- LY=LYC as it was when the LCD went off (the comparison stops with it)
global win_line: Int = 0
global stat_line: Int = 0
global vbk: Int = 0
global bcps: Int = 0
global ocps: Int = 0
global opri: Int = 0
export global frame_done: Int = 0
export global frames: Int = 0
global dmg_shades: Int = 0
array vram: Byte[0x4000]
array oam: Byte[0xA0]
export array frame: Byte[69120]
array bgpal: Byte[64]
array obpal: Byte[64]
array line_bg: Int[160]          -- per pixel: BG colour index (bits 0-1) | BG-over-OBJ attribute (bit 2)
array line_sp: Int[160]          -- per pixel: OBJ colour + 1 (0 = none) | palette << 8 | behind-BG << 16
array sprites: Int[10]
array obj_tile: Int[22]          -- per background tile: the leftmost object edge in it (8: none)
array shade_r: Int[4] = [0xE0, 0x88, 0x34, 0x08]
array shade_g: Int[4] = [0xF8, 0xC0, 0x68, 0x18]
array shade_b: Int[4] = [0xD0, 0x70, 0x56, 0x20]

fn vram_index(a: Int) -> Int = (vbk << 13) | (a & 0x1FFF)
fn lcd_on() -> Bool = (lcdc & 0x80) != 0
-- dots since the current line began, and where the CPU's view of mode 3 ends on it
fn line_dot() -> Int = now - line_start
fn view_mode3_end() -> Int = MODE2_DOTS + mode3_len + VIEW_LAG
fn vram_blocked() -> Bool {
  if not lcd_on() or ly >= SCREEN_H {
    return false
  }
  let d = line_dot()
  let start = if first_line != 0 then MODE2_DOTS + VIEW_LAG else MODE2_DOTS
  return d >= start and (mode == 3 or d < view_mode3_end())
}
fn oam_blocked() -> Bool {
  if not lcd_on() or ly >= SCREEN_H {
    return false
  }
  let d = line_dot()
  if first_line != 0 and d < MODE2_DOTS + VIEW_LAG {
    return false
  }
  return mode == 2 or mode == 3 or d < view_mode3_end()
}
fn vram_write_blocked() -> Bool {
  if not lcd_on() or ly >= SCREEN_H {
    return false
  }
  let d = line_dot()
  return d >= MODE2_DOTS + VIEW_LAG and (mode == 3 or d < view_mode3_end())
}
fn oam_write_blocked() -> Bool {
  if not lcd_on() or ly >= SCREEN_H {
    return false
  }
  let d = line_dot()
  if d >= MODE2_DOTS + VIEW_LAG {
    return mode == 3 or d < view_mode3_end()
  }
  return first_line == 0 and d >= VIEW_LAG and d < MODE2_DOTS
}
-- the STAT mode bits as the CPU reads them
fn view_mode() -> Int {
  if ly >= SCREEN_H {
    return mode
  }
  let d = line_dot()
  if first_line != 0 {
    if d < MODE2_DOTS + VIEW_LAG {
      return 0
    }
  } elif d < VIEW_LAG {
    return 0
  } elif d < MODE2_DOTS + VIEW_LAG {
    return 2
  }
  if mode == 3 or d < view_mode3_end() {
    return 3
  }
  return 0
}
-- The DMG's OAM corruption bug (Pan Docs): while the OAM scan reads row r (8 bytes; row d // 4 at dot d of mode
-- 2, so from L+4 to L+76: Blargg oam_bug 4-scanline_timing), an OAM access or an IDU address in FE00-FEFF
-- rewrites it from the row before. Words are 16-bit: a =
-- row r word 0, b = row r-1 word 0, c = row r-1 word 2. Write: word 0 = ((a ^ c) & (b ^ c)) ^ c; read: word 0 =
-- b | (a & c); both then copy words 1-3 from row r-1. A read that increments first (rows 4-18) sets row r-1
-- word 0 = (b & (x | a | c)) | (x & a & c) with x = row r-2 word 0, and copies row r-1 to rows r-2 and r.
const OAM_BUG_WRITE = 1
const OAM_BUG_READ = 2
const OAM_BUG_READ_IDU = 3
fn oam_bug_row() -> Int {
  if cgb != 0 or not lcd_on() or ly >= SCREEN_H or first_line != 0 {
    return -1
  }
  let d = line_dot()
  if d < 0 or d >= MODE2_DOTS {
    return -1
  }
  return d // 4
}
fn oam_word(r: Int, i: Int) -> Int = oam[r * 8 + i * 2] | (oam[r * 8 + i * 2 + 1] << 8)
fn set_oam_word(r: Int, i: Int, v: Int) {
  oam[r * 8 + i * 2] = v & 0xFF
  oam[r * 8 + i * 2 + 1] = (v >> 8) & 0xFF
}
fn oam_bug(kind: Int) {
  ppu_sync()
  let r = oam_bug_row()
  if r < 1 {
    return
  }
  if kind == OAM_BUG_READ_IDU {
    if r >= 4 and r < 19 {
      let x = oam_word(r - 2, 0)
      let a = oam_word(r, 0)
      let b = oam_word(r - 1, 0)
      let c = oam_word(r - 1, 2)
      set_oam_word(r - 1, 0, (b & (x | a | c)) | (x & a & c))
      for i in 0 .. 8 {
        oam[(r - 2) * 8 + i] = oam[(r - 1) * 8 + i]
        oam[r * 8 + i] = oam[(r - 1) * 8 + i]
      }
    }
    return
  }
  let a = oam_word(r, 0)
  let b = oam_word(r - 1, 0)
  let c = oam_word(r - 1, 2)
  set_oam_word(r, 0, if kind == OAM_BUG_WRITE then ((a ^ c) & (b ^ c)) ^ c else b | (a & c))
  for i in 2 .. 8 {
    oam[r * 8 + i] = oam[(r - 1) * 8 + i]
  }
}
-- FEA0-FEFF, the unusable range: on the DMG it reads 0x00 while OAM is open and 0xFF while it is blocked, and an
-- access then corrupts OAM like one inside it (Pan Docs memory map)
fn unusable_read(a: Int) -> Int {
  if cgb != 0 {
    return 0
  }
  ppu_sync()
  if oam_blocked() {
    oam_bug(OAM_BUG_READ)
    return 0xFF
  }
  return 0
}
fn unusable_write(a: Int) {
  if cgb == 0 {
    ppu_sync()
    if oam_write_blocked() {
      oam_bug(OAM_BUG_WRITE)
    }
  }
}
fn vram_read(a: Int) -> Int {
  ppu_sync()
  if vram_blocked() {
    return 0xFF
  }
  return vram[vram_index(a)]
}
fn vram_write(a: Int, v: Int) {
  ppu_sync()
  if vram_write_blocked() {
    return
  }
  vram[vram_index(a)] = v
}
fn oam_read(a: Int) -> Int {
  ppu_sync()
  if oam_blocked() {
    oam_bug(OAM_BUG_READ)
    return 0xFF
  }
  return oam[a - 0xFE00]
}
fn oam_write(a: Int, v: Int) {
  ppu_sync()
  if oam_write_blocked() {
    oam_bug(OAM_BUG_WRITE)
    return
  }
  oam[a - 0xFE00] = v
}

-- LY=LYC as STAT shows it: false for the first dots of a line (the comparison restarts with the new LY), held
-- while the LCD is off
fn lyc_seen() -> Bool {
  if not lcd_on() {
    return lyc_latched != 0
  }
  return ly == lyc and (ly >= SCREEN_H or first_line != 0 or line_dot() >= VIEW_LAG)
}
fn stat_update() {
  var s = 0
  let same = if lcd_on() then ly == lyc else lyc_latched != 0
  if same and (stat_sel & 0x40) != 0 {
    s = 1
  }
  if lcd_on() {
    if mode == 0 and (stat_sel & 0x08) != 0 {
      s = 1
    }
    if mode == 1 and (stat_sel & 0x10) != 0 {
      s = 1
    }
    if (mode == 2 or vblank_m2 != 0) and (stat_sel & 0x20) != 0 {
      s = 1
    }
  }
  if s == 1 and stat_line == 0 {
    request_irq(IRQ_STAT)
  }
  stat_line = s
}
fn ppu_sync() {
  while now >= ppu_next {
    ppu_step()
  }
}
fn ppu_step() {
  if not lcd_on() {
    ppu_next = FAR
    return
  }
  if mode == 2 or first_line == 1 {
    mode = 3
    first_line = if first_line != 0 then 2 else 0
    mode3_len = mode3_length()
    ppu_next = line_start + MODE2_DOTS + mode3_len
  } elif mode == 3 {
    render_line()
    mode = 0
    ppu_next = line_start + DOTS_PER_LINE
    hdma_hblank()
  } else {
    line_start = line_start + DOTS_PER_LINE
    first_line = 0
    ly += 1
    if ly == SCREEN_H {
      mode = 1
      vblank_m2 = 1
      request_irq(IRQ_VBLANK)
      frame_done = 1
      frames += 1
      ppu_next = line_start + DOTS_PER_LINE
    } elif ly >= LINES {
      ly = 0
      win_line = 0
      mode = 2
      ppu_next = line_start + MODE2_DOTS
    } elif ly > SCREEN_H {
      ppu_next = line_start + DOTS_PER_LINE
    } else {
      mode = 2
      ppu_next = line_start + MODE2_DOTS
    }
  }
  stat_update()
  vblank_m2 = 0
}
-- the next dot at which the PPU may request an interrupt or stall the CPU (an HDMA block): every transition
-- while STAT mode 0/2 sources or H-blank DMA are on, else the next V-blank or the next LY=LYC line
fn ppu_irq_next() -> Int {
  if not lcd_on() {
    return FAR
  }
  if (stat_sel & 0x28) != 0 or hdma_on != 0 {
    return ppu_next
  }
  var t = line_start + (SCREEN_H - ly) * DOTS_PER_LINE
  if ly >= SCREEN_H {
    t = line_start + (LINES - ly + SCREEN_H) * DOTS_PER_LINE
  }
  if (stat_sel & 0x40) != 0 {
    var k = lyc - ly
    if k <= 0 {
      k += LINES
    }
    let tl = line_start + k * DOTS_PER_LINE
    if tl < t {
      t = tl
    }
  }
  return t
}
fn sprite_height() -> Int = if (lcdc & 0x04) != 0 then 16 else 8
-- mode 2: the first 10 objects (in OAM order) whose rows cover this line
fn oam_scan() -> Int {
  var n = 0
  let h = sprite_height()
  var i = 0
  while i < 40 and n < 10 {
    let y = oam[i * 4] - 16
    if ly >= y and ly < y + h {
      sprites[n] = i
      n += 1
    }
    i += 1
  }
  return n
}
-- 6 dots per object fetched (OAM X below 168), and once per background tile holding an object's left edge, the
-- pixels of the tile right of the leftmost such edge, less 2 (the background fetch it waits for)
fn obj_penalty(n: Int) -> Int {
  for t in 0 .. 22 {
    obj_tile[t] = 8
  }
  var pen = 0
  for k in 0 .. n {
    let x = oam[sprites[k] * 4 + 1]
    if x < 168 {
      pen += OBJ_FETCH_DOTS
      let p = x + (scx & 7)
      if (p & 7) < obj_tile[p >> 3] {
        obj_tile[p >> 3] = p & 7
      }
    }
  }
  for t in 0 .. 22 {
    if obj_tile[t] < 5 {
      pen += 5 - obj_tile[t]
    }
  }
  return pen
}
fn mode3_length() -> Int {
  var len = MODE3_DOTS + (scx & 7)
  if (lcdc & 0x02) != 0 {
    len += obj_penalty(oam_scan())
  }
  if (lcdc & 0x20) != 0 and wy <= ly and wx < 167 {
    len += 6
  }
  if len > 289 {
    len = 289
  }
  return len
}
fn ppu_read(r: Int) -> Int {
  if r == 0x40 {
    return lcdc
  }
  if r == 0x41 {
    var m = 0
    var eq = 0
    if lcd_on() {
      m = view_mode()
    }
    if lyc_seen() {
      eq = 4
    }
    return 0x80 | stat_sel | eq | m
  }
  if r == 0x42 {
    return scy
  }
  if r == 0x43 {
    return scx
  }
  if r == 0x44 {
    return ly
  }
  if r == 0x45 {
    return lyc
  }
  if r == 0x46 {
    return dma_reg
  }
  if r == 0x47 {
    return bgp
  }
  if r == 0x48 {
    return obp0
  }
  if r == 0x49 {
    return obp1
  }
  if r == 0x4A {
    return wy
  }
  return wx
}
fn ppu_write(r: Int, v: Int) {
  if r == 0x40 {
    let was = lcd_on()
    let lyc_was = lyc_seen()
    lcdc = v
    if was and not lcd_on() {
      lyc_latched = if lyc_was then 1 else 0
      ly = 0
      mode = 0
      ppu_next = FAR
    } elif not was and lcd_on() {
      ly = 0
      line_start = now - LCDON_SHORT
      mode = 0
      first_line = 1
      win_line = 0
      ppu_next = line_start + MODE2_DOTS
    }
  } elif r == 0x41 {
    stat_sel = v & 0x78
  } elif r == 0x42 {
    scy = v
  } elif r == 0x43 {
    scx = v
  } elif r == 0x44 {
    return
  } elif r == 0x45 {
    lyc = v
  } elif r == 0x46 {
    dma_start(v)
  } elif r == 0x47 {
    bgp = v
  } elif r == 0x48 {
    obp0 = v
  } elif r == 0x49 {
    obp1 = v
  } elif r == 0x4A {
    wy = v
  } else {
    wx = v
  }
  stat_update()
}

-- drawing one line ---------------------------------------------------------------------------------
fn tile_row_addr(tile: Int, row: Int, high_bank: Int) -> Int {
  var base = 0
  if (lcdc & 0x10) != 0 {
    base = tile * 16
  } else {
    base = 0x1000 + sext8(tile) * 16
  }
  return (high_bank << 13) + base + row * 2
}
fn draw_bg_span(x0: Int, x1: Int, map_base: Int, px: Int, py: Int) {
  -- pixels x0..x1-1 of this line come from the map at (px + x - x0, py)
  var x = x0
  while x < x1 {
    let mx = (px + x - x0) & 0xFF
    let col = mx >> 3
    let tile = vram[map_base + ((py >> 3) << 5) + col]
    var attr = 0
    if cgb != 0 {
      attr = vram[0x2000 + map_base + ((py >> 3) << 5) + col]
    }
    var row = py & 7
    if (attr & 0x40) != 0 {
      row = 7 - row
    }
    let addr = tile_row_addr(tile, row, (attr >> 3) & 1)
    let lo = vram[addr]
    let hi = vram[addr + 1]
    var fine = mx & 7
    while fine < 8 and x < x1 {
      var bit = 7 - fine
      if (attr & 0x20) != 0 {
        bit = fine
      }
      let c = (((hi >> bit) & 1) << 1) | ((lo >> bit) & 1)
      line_bg[x] = c | ((attr >> 5) & 4) | ((attr & 7) << 3)
      fine += 1
      x += 1
    }
  }
}
fn draw_sprites(n: Int) {
  for x in 0 .. SCREEN_W {
    line_sp[x] = 0
  }
  if (lcdc & 0x02) == 0 {
    return
  }
  let h = sprite_height()
  -- priority: CGB = OAM order; DMG = smaller X first, then OAM order. Draw best-first, never overwrite.
  var done = 0
  var used = 0
  while done < n {
    var best = -1
    var bx = 1000
    var k = 0
    while k < n {
      if (used & (1 << k)) == 0 {
        let i = sprites[k]
        let sx = oam[i * 4 + 1]
        if best < 0 or (cgb == 0 and sx < bx) {
          best = k
          bx = sx
        }
      }
      k += 1
    }
    used = used | (1 << best)
    done += 1
    let i = sprites[best]
    let sy = oam[i * 4] - 16
    let sx = oam[i * 4 + 1] - 8
    var tile = oam[i * 4 + 2]
    let attr = oam[i * 4 + 3]
    var row = ly - sy
    if (attr & 0x40) != 0 {
      row = h - 1 - row
    }
    if h == 16 {
      tile = (tile & 0xFE) | (row >> 3)
      row = row & 7
    }
    var bank = 0
    if cgb != 0 {
      bank = (attr >> 3) & 1
    }
    let addr = (bank << 13) + tile * 16 + row * 2
    let lo = vram[addr]
    let hi = vram[addr + 1]
    var pal = (attr >> 4) & 1
    if cgb != 0 {
      pal = attr & 7
    }
    for px in 0 .. 8 {
      let x = sx + px
      if x >= 0 and x < SCREEN_W {
        if line_sp[x] == 0 {
          var bit = 7 - px
          if (attr & 0x20) != 0 {
            bit = px
          }
          let c = (((hi >> bit) & 1) << 1) | ((lo >> bit) & 1)
          if c != 0 {
            line_sp[x] = (c + 1) | (pal << 8) | (((attr >> 7) & 1) << 16)
          }
        }
      }
    }
  }
}
fn put_pixel(x: Int, r: Int, g: Int, b: Int) {
  let o = (ly * SCREEN_W + x) * 3
  frame[o] = r
  frame[o + 1] = g
  frame[o + 2] = b
}
fn put_cgb(x: Int, lo: Int, hi: Int) {
  let c = lo | (hi << 8)
  let r = c & 0x1F
  let g = (c >> 5) & 0x1F
  let b = (c >> 10) & 0x1F
  put_pixel(x, (r << 3) | (r >> 2), (g << 3) | (g >> 2), (b << 3) | (b >> 2))
}
fn render_line() {
  if ly >= SCREEN_H {
    return
  }
  -- background (on the DMG, LCDC bit 0 off means a blank background)
  if cgb != 0 or (lcdc & 0x01) != 0 {
    var map_bg = 0x1800
    if (lcdc & 0x08) != 0 {
      map_bg = 0x1C00
    }
    draw_bg_span(0, SCREEN_W, map_bg, scx, (scy + ly) & 0xFF)
    if (lcdc & 0x20) != 0 and wy <= ly and wx < 167 {
      var map_w = 0x1800
      if (lcdc & 0x40) != 0 {
        map_w = 0x1C00
      }
      var x0 = wx - 7
      var skip = 0
      if x0 < 0 {
        skip = -x0
        x0 = 0
      }
      draw_bg_span(x0, SCREEN_W, map_w, skip, win_line)
      win_line += 1
    }
  } else {
    for x in 0 .. SCREEN_W {
      line_bg[x] = 0
    }
  }
  let n = oam_scan()
  draw_sprites(n)
  for x in 0 .. SCREEN_W {
    let bgv = line_bg[x]
    let c = bgv & 3
    let sp = line_sp[x]
    var use_sp = false
    if sp != 0 {
      if cgb != 0 and (lcdc & 0x01) == 0 {
        use_sp = true
      } elif c == 0 {
        use_sp = true
      } elif (sp >> 16) == 0 and (bgv & 4) == 0 {
        use_sp = true
      }
    }
    if cgb != 0 {
      if use_sp {
        let p = ((sp >> 8) & 7) * 8 + ((sp & 0xFF) - 1) * 2
        put_cgb(x, obpal[p], obpal[p + 1])
      } else {
        let p = ((bgv >> 3) & 7) * 8 + c * 2
        put_cgb(x, bgpal[p], bgpal[p + 1])
      }
    } else {
      var shade = (bgp >> (c * 2)) & 3
      if use_sp {
        var op = obp0
        if ((sp >> 8) & 1) != 0 {
          op = obp1
        }
        shade = (op >> (((sp & 0xFF) - 1) * 2)) & 3
      }
      put_pixel(x, shade_r[shade], shade_g[shade], shade_b[shade])
    }
  }
}
