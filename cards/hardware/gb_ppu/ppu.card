-- The PPU (LCD controller). A frame is 154 lines of 456 dots (70224 dots). Visible lines 0-143 go through mode 2
-- (OAM scan, 80 dots), mode 3 (drawing, 172 dots + penalties for SCX and sprites) and mode 0 (H-blank, the rest);
-- lines 144-153 are mode 1 (V-blank, requested at the start of line 144). STAT requests an interrupt on the
-- rising edge of (LY=LYC and bit 6) or (mode 0 and bit 3) or (mode 1 and bit 4) or (mode 2 and bit 5).
-- A line is drawn when mode 3 ends, from the registers as they are then (a scanline renderer: changes made in
-- the middle of mode 3 apply to the whole line). DMG shades and CGB colours (RGB555) both end as RGB888 in
-- `frame`. VRAM is blocked in mode 3 and OAM in modes 2 and 3 while the LCD is on.
const DOTS_PER_LINE = 456
const LINES = 154
const MODE2_DOTS = 80
const MODE3_DOTS = 172
const SCREEN_W = 160
const SCREEN_H = 144
global lcdc: Int = 0x91
global stat_sel: Int = 0
global ly: Int = 0
global lyc: Int = 0
global scy: Int = 0
global scx: Int = 0
global wy: Int = 0
global wx: Int = 0
global bgp: Int = 0xFC
global obp0: Int = 0xFF
global obp1: Int = 0xFF
global mode: Int = 2
global ppu_next: Int = 80
global line_start: Int = 0
global mode3_len: Int = 172
global win_line: Int = 0
global stat_line: Int = 0
global vbk: Int = 0
global bcps: Int = 0
global ocps: Int = 0
global opri: Int = 0
export global frame_done: Int = 0
export global frames: Int = 0
global dmg_shades: Int = 0
array vram: Byte[0x4000]
array oam: Byte[0xA0]
export array frame: Byte[69120]
array bgpal: Byte[64]
array obpal: Byte[64]
array line_bg: Int[160]          -- per pixel: BG colour index (bits 0-1) | BG-over-OBJ attribute (bit 2)
array line_sp: Int[160]          -- per pixel: OBJ colour + 1 (0 = none) | palette << 8 | behind-BG << 16
array sprites: Int[10]
array shade_r: Int[4] = [0xE0, 0x88, 0x34, 0x08]
array shade_g: Int[4] = [0xF8, 0xC0, 0x68, 0x18]
array shade_b: Int[4] = [0xD0, 0x70, 0x56, 0x20]

fn vram_index(a: Int) -> Int = (vbk << 13) | (a & 0x1FFF)
fn lcd_on() -> Bool = (lcdc & 0x80) != 0
fn vram_read(a: Int) -> Int {
  ppu_sync()
  if lcd_on() and mode == 3 {
    return 0xFF
  }
  return vram[vram_index(a)]
}
fn vram_write(a: Int, v: Int) {
  ppu_sync()
  if lcd_on() and mode == 3 {
    return
  }
  vram[vram_index(a)] = v
}
fn oam_read(a: Int) -> Int {
  ppu_sync()
  if lcd_on() and (mode == 2 or mode == 3) {
    return 0xFF
  }
  return oam[a - 0xFE00]
}
fn oam_write(a: Int, v: Int) {
  ppu_sync()
  if lcd_on() and (mode == 2 or mode == 3) {
    return
  }
  oam[a - 0xFE00] = v
}

fn stat_update() {
  var s = 0
  if lcd_on() {
    if ly == lyc and (stat_sel & 0x40) != 0 {
      s = 1
    }
    if mode == 0 and (stat_sel & 0x08) != 0 {
      s = 1
    }
    if mode == 1 and (stat_sel & 0x10) != 0 {
      s = 1
    }
    if mode == 2 and (stat_sel & 0x20) != 0 {
      s = 1
    }
  }
  if s == 1 and stat_line == 0 {
    request_irq(IRQ_STAT)
  }
  stat_line = s
}
fn ppu_sync() {
  while now >= ppu_next {
    ppu_step()
  }
}
fn ppu_step() {
  if not lcd_on() {
    ppu_next = FAR
    return
  }
  if mode == 2 {
    mode = 3
    mode3_len = mode3_length()
    ppu_next = line_start + MODE2_DOTS + mode3_len
  } elif mode == 3 {
    render_line()
    mode = 0
    ppu_next = line_start + DOTS_PER_LINE
    hdma_hblank()
  } else {
    line_start = line_start + DOTS_PER_LINE
    ly += 1
    if ly == SCREEN_H {
      mode = 1
      request_irq(IRQ_VBLANK)
      frame_done = 1
      frames += 1
      ppu_next = line_start + DOTS_PER_LINE
    } elif ly >= LINES {
      ly = 0
      win_line = 0
      mode = 2
      ppu_next = line_start + MODE2_DOTS
    } elif ly > SCREEN_H {
      ppu_next = line_start + DOTS_PER_LINE
    } else {
      mode = 2
      ppu_next = line_start + MODE2_DOTS
    }
  }
  stat_update()
}
-- the next dot at which the PPU may request an interrupt or stall the CPU (an HDMA block): every transition
-- while STAT mode 0/2 sources or H-blank DMA are on, else the next V-blank or the next LY=LYC line
fn ppu_irq_next() -> Int {
  if not lcd_on() {
    return FAR
  }
  if (stat_sel & 0x28) != 0 or hdma_on != 0 {
    return ppu_next
  }
  var t = line_start + (SCREEN_H - ly) * DOTS_PER_LINE
  if ly >= SCREEN_H {
    t = line_start + (LINES - ly + SCREEN_H) * DOTS_PER_LINE
  }
  if (stat_sel & 0x40) != 0 {
    var k = lyc - ly
    if k <= 0 {
      k += LINES
    }
    let tl = line_start + k * DOTS_PER_LINE
    if tl < t {
      t = tl
    }
  }
  return t
}
fn sprite_height() -> Int = if (lcdc & 0x04) != 0 then 16 else 8
-- mode 2: the first 10 objects (in OAM order) whose rows cover this line
fn oam_scan() -> Int {
  var n = 0
  let h = sprite_height()
  var i = 0
  while i < 40 and n < 10 {
    let y = oam[i * 4] - 16
    if ly >= y and ly < y + h {
      sprites[n] = i
      n += 1
    }
    i += 1
  }
  return n
}
fn mode3_length() -> Int {
  var len = MODE3_DOTS + (scx & 7)
  if (lcdc & 0x02) != 0 {
    len += 6 * oam_scan()
  }
  if (lcdc & 0x20) != 0 and wy <= ly and wx < 167 {
    len += 6
  }
  if len > 289 {
    len = 289
  }
  return len
}
fn ppu_read(r: Int) -> Int {
  if r == 0x40 {
    return lcdc
  }
  if r == 0x41 {
    var m = 0
    var eq = 0
    if lcd_on() {
      m = mode
      if ly == lyc {
        eq = 4
      }
    }
    return 0x80 | stat_sel | eq | m
  }
  if r == 0x42 {
    return scy
  }
  if r == 0x43 {
    return scx
  }
  if r == 0x44 {
    return ly
  }
  if r == 0x45 {
    return lyc
  }
  if r == 0x46 {
    return dma_reg
  }
  if r == 0x47 {
    return bgp
  }
  if r == 0x48 {
    return obp0
  }
  if r == 0x49 {
    return obp1
  }
  if r == 0x4A {
    return wy
  }
  return wx
}
fn ppu_write(r: Int, v: Int) {
  if r == 0x40 {
    let was = lcd_on()
    lcdc = v
    if was and not lcd_on() {
      ly = 0
      mode = 0
      ppu_next = FAR
      stat_line = 0
    } elif not was and lcd_on() {
      ly = 0
      line_start = now
      mode = 2
      win_line = 0
      ppu_next = now + MODE2_DOTS
    }
  } elif r == 0x41 {
    stat_sel = v & 0x78
  } elif r == 0x42 {
    scy = v
  } elif r == 0x43 {
    scx = v
  } elif r == 0x44 {
    return
  } elif r == 0x45 {
    lyc = v
  } elif r == 0x46 {
    dma_start(v)
  } elif r == 0x47 {
    bgp = v
  } elif r == 0x48 {
    obp0 = v
  } elif r == 0x49 {
    obp1 = v
  } elif r == 0x4A {
    wy = v
  } else {
    wx = v
  }
  stat_update()
}

-- drawing one line ---------------------------------------------------------------------------------
fn tile_row_addr(tile: Int, row: Int, high_bank: Int) -> Int {
  var base = 0
  if (lcdc & 0x10) != 0 {
    base = tile * 16
  } else {
    base = 0x1000 + sext8(tile) * 16
  }
  return (high_bank << 13) + base + row * 2
}
fn draw_bg_span(x0: Int, x1: Int, map_base: Int, px: Int, py: Int) {
  -- pixels x0..x1-1 of this line come from the map at (px + x - x0, py)
  var x = x0
  while x < x1 {
    let mx = (px + x - x0) & 0xFF
    let col = mx >> 3
    let tile = vram[map_base + ((py >> 3) << 5) + col]
    var attr = 0
    if cgb != 0 {
      attr = vram[0x2000 + map_base + ((py >> 3) << 5) + col]
    }
    var row = py & 7
    if (attr & 0x40) != 0 {
      row = 7 - row
    }
    let addr = tile_row_addr(tile, row, (attr >> 3) & 1)
    let lo = vram[addr]
    let hi = vram[addr + 1]
    var fine = mx & 7
    while fine < 8 and x < x1 {
      var bit = 7 - fine
      if (attr & 0x20) != 0 {
        bit = fine
      }
      let c = (((hi >> bit) & 1) << 1) | ((lo >> bit) & 1)
      line_bg[x] = c | ((attr >> 5) & 4) | ((attr & 7) << 3)
      fine += 1
      x += 1
    }
  }
}
fn draw_sprites(n: Int) {
  for x in 0 .. SCREEN_W {
    line_sp[x] = 0
  }
  if (lcdc & 0x02) == 0 {
    return
  }
  let h = sprite_height()
  -- priority: CGB = OAM order; DMG = smaller X first, then OAM order. Draw best-first, never overwrite.
  var done = 0
  var used = 0
  while done < n {
    var best = -1
    var bx = 1000
    var k = 0
    while k < n {
      if (used & (1 << k)) == 0 {
        let i = sprites[k]
        let sx = oam[i * 4 + 1]
        if best < 0 or (cgb == 0 and sx < bx) {
          best = k
          bx = sx
        }
      }
      k += 1
    }
    used = used | (1 << best)
    done += 1
    let i = sprites[best]
    let sy = oam[i * 4] - 16
    let sx = oam[i * 4 + 1] - 8
    var tile = oam[i * 4 + 2]
    let attr = oam[i * 4 + 3]
    var row = ly - sy
    if (attr & 0x40) != 0 {
      row = h - 1 - row
    }
    if h == 16 {
      tile = (tile & 0xFE) | (row >> 3)
      row = row & 7
    }
    var bank = 0
    if cgb != 0 {
      bank = (attr >> 3) & 1
    }
    let addr = (bank << 13) + tile * 16 + row * 2
    let lo = vram[addr]
    let hi = vram[addr + 1]
    var pal = (attr >> 4) & 1
    if cgb != 0 {
      pal = attr & 7
    }
    for px in 0 .. 8 {
      let x = sx + px
      if x >= 0 and x < SCREEN_W {
        if line_sp[x] == 0 {
          var bit = 7 - px
          if (attr & 0x20) != 0 {
            bit = px
          }
          let c = (((hi >> bit) & 1) << 1) | ((lo >> bit) & 1)
          if c != 0 {
            line_sp[x] = (c + 1) | (pal << 8) | (((attr >> 7) & 1) << 16)
          }
        }
      }
    }
  }
}
fn put_pixel(x: Int, r: Int, g: Int, b: Int) {
  let o = (ly * SCREEN_W + x) * 3
  frame[o] = r
  frame[o + 1] = g
  frame[o + 2] = b
}
fn put_cgb(x: Int, lo: Int, hi: Int) {
  let c = lo | (hi << 8)
  let r = c & 0x1F
  let g = (c >> 5) & 0x1F
  let b = (c >> 10) & 0x1F
  put_pixel(x, (r << 3) | (r >> 2), (g << 3) | (g >> 2), (b << 3) | (b >> 2))
}
fn render_line() {
  if ly >= SCREEN_H {
    return
  }
  -- background (on the DMG, LCDC bit 0 off means a blank background)
  if cgb != 0 or (lcdc & 0x01) != 0 {
    var map_bg = 0x1800
    if (lcdc & 0x08) != 0 {
      map_bg = 0x1C00
    }
    draw_bg_span(0, SCREEN_W, map_bg, scx, (scy + ly) & 0xFF)
    if (lcdc & 0x20) != 0 and wy <= ly and wx < 167 {
      var map_w = 0x1800
      if (lcdc & 0x40) != 0 {
        map_w = 0x1C00
      }
      var x0 = wx - 7
      var skip = 0
      if x0 < 0 {
        skip = -x0
        x0 = 0
      }
      draw_bg_span(x0, SCREEN_W, map_w, skip, win_line)
      win_line += 1
    }
  } else {
    for x in 0 .. SCREEN_W {
      line_bg[x] = 0
    }
  }
  let n = oam_scan()
  draw_sprites(n)
  for x in 0 .. SCREEN_W {
    let bgv = line_bg[x]
    let c = bgv & 3
    let sp = line_sp[x]
    var use_sp = false
    if sp != 0 {
      if cgb != 0 and (lcdc & 0x01) == 0 {
        use_sp = true
      } elif c == 0 {
        use_sp = true
      } elif (sp >> 16) == 0 and (bgv & 4) == 0 {
        use_sp = true
      }
    }
    if cgb != 0 {
      if use_sp {
        let p = ((sp >> 8) & 7) * 8 + ((sp & 0xFF) - 1) * 2
        put_cgb(x, obpal[p], obpal[p + 1])
      } else {
        let p = ((bgv >> 3) & 7) * 8 + c * 2
        put_cgb(x, bgpal[p], bgpal[p + 1])
      }
    } else {
      var shade = (bgp >> (c * 2)) & 3
      if use_sp {
        var op = obp0
        if ((sp >> 8) & 1) != 0 {
          op = obp1
        }
        shade = (op >> (((sp & 0xFF) - 1) * 2)) & 3
      }
      put_pixel(x, shade_r[shade], shade_g[shade], shade_b[shade])
    }
  }
}
