-- The 3D engine with nothing drawn: every geometry command is taken at once, so the FIFO is always empty and
-- the engine idle. GXSTAT reads as idle plus the bits the game wrote (the FIFO interrupt mode in bits 30-31);
-- writing bit 15 clears the overflow error. While the FIFO interrupt mode is set its condition holds (empty is
-- also less than half full), so the interrupt is requested every line.
const GXSTAT_IDLE = card.hardware.nds_3d.gxstat_idle
const IRQ_GXFIFO = card.hardware.nds_3d.irq_gxfifo
global gxstat_irq: Int = 0
export global gx_commands: Int = 0

fn gx_read8(o: Int) -> Int {
  let v = GXSTAT_IDLE | (gxstat_irq << 30)
  return (v >> ((o & 3) * 8)) & 0xFF
}
fn gx_written(o: Int, v: Int) {
  if o == 0x603 {
    gxstat_irq = (v >> 6) & 3
  } elif o >= 0x400 and o < 0x600 and (o & 3) == 3 {
    gx_commands += 1
  }
}
fn gx_line() {
  if gxstat_irq != 0 {
    request(0, IRQ_GXFIFO)
  }
}
