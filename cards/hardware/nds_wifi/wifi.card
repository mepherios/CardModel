-- The ARM7's wireless hardware at 0x04800000 (16-bit registers at 0x04808000, 8 KiB of Wi-Fi RAM at 0x04804000,
-- both mirrored through 0x0480FFFF), as far as a game's wireless driver needs it to come up and stay idle: the
-- register file, the baseband chip's registers behind W_BB_CNT (writes stored, reads answered, its fixed ones
-- fixed), the RF chip's behind W_RF_DATA1/2 and W_RF_CNT, power-up (requested, then after WIFI_WAKE_US
-- microseconds the radio is awake: W_POWERSTATE clear, the RF wake-up interrupt), the microsecond counter with its
-- compare (beacon) interrupt, the beacon count and the pre-beacon interrupt, the random generator, the RX and TX
-- buffer ports into the Wi-Fi RAM, and TX requests that complete after WIFI_TX_US with their status written.
-- Interrupts are W_IF & W_IE, raised on the ARM7's Wi-Fi line (IE/IF bit 24). Nothing is ever received: there is
-- no other console and no access point.
const WIFI_ID = card.hardware.nds_wifi.chip_id
const WIFI_WAKE_US = card.hardware.nds_wifi.wake_microseconds
const WIFI_TX_US = card.hardware.nds_wifi.tx_microseconds
const WIFI_BUS_HZ = card.hardware.nds_wifi.bus_hz
const IRQ_WIFI = 0x1000000
array wifi_reg: Int[0x800]                   -- the 16-bit registers by offset / 2
export array wifi_ram: Byte[0x2000]
array bb_reg: Int[0x100]
array bb_fixed: Int[0x100]                   -- 1: a read-only baseband register
array rf_reg: Int[0x40]
array bb_fixed_list: Int[42] = card.hardware.nds_wifi.baseband.fixed
global wifi_acc: Int = 0                     -- bus cycles x 1000000 not yet a whole microsecond
export global wifi_us: Int = 0               -- W_US_COUNT
global wifi_compare: Int = 0                 -- W_US_COMPARE (bits 10 and up)
global wifi_wake: Int = 0                    -- microseconds until the radio is awake (0: no wake-up under way)
global wifi_tx_left: Int = 0                 -- microseconds until the TX in progress completes
global wifi_tx_slot: Int = 0
global wifi_random: Int = 1
export global wifi_irqs: Int = 0             -- interrupts raised (for the coverage report)

fn wreg(o: Int) -> Int = wifi_reg[(o & 0xFFF) >> 1]
fn wset(o: Int, v: Int) {
  wifi_reg[(o & 0xFFF) >> 1] = v & 0xFFFF
}
fn wifi_irq(bit: Int) {
  let was = wreg(0x010) & wreg(0x012)
  wset(0x010, wreg(0x010) | (1 << bit))
  wifi_irqs += 1
  if was == 0 and (wreg(0x010) & wreg(0x012)) != 0 {
    request(1, IRQ_WIFI)
  }
}
fn wifi_reset() {
  for i in 0 .. 0x800 {
    wifi_reg[i] = 0
  }
  for i in 0 .. 0x2000 {
    wifi_ram[i] = 0
  }
  for i in 0 .. 0x100 {
    bb_reg[i] = 0
    bb_fixed[i] = if i >= 0x69 then 1 else 0
  }
  for k in 0 .. 21 {
    bb_fixed[bb_fixed_list[k * 2]] = 1
    bb_reg[bb_fixed_list[k * 2]] = bb_fixed_list[k * 2 + 1]
  }
  for i in 0 .. 0x40 {
    rf_reg[i] = 0
  }
  wset(0x000, WIFI_ID)
  wset(0x034, 0x0002)
  wset(0x03C, 0x0200)                        -- powered down
  wifi_us = 0
  wifi_compare = 0
  wifi_acc = 0
  wifi_wake = 0
  wifi_tx_left = 0
  wifi_random = 1
}
-- the radio's power: on when POWCNT2 enables Wi-Fi and W_POWER_US does not hold it down
fn wifi_powered() -> Bool = (io_file[0x2000 | 0x304] & 2) != 0 and (wreg(0x036) & 1) == 0
fn wifi_wake_up() {
  wset(0x03C, wreg(0x03C) | 0x0100)          -- waking up
  wifi_wake = WIFI_WAKE_US
}
fn wifi_awake() {
  wset(0x03C, 0)
  wset(0x19C, 0x00C6)                        -- W_RF_PINS: receiving
  wset(0x214, 9)                             -- W_RF_STATUS: idle
  wifi_irq(11)
}
-- RF chip transfers (the RF2958 kind, the console's firmware type 2): register id in W_RF_DATA2 bits 2-6, bit 7 a
-- read; 18 data bits in W_RF_DATA1 and W_RF_DATA2 bits 0-1
fn rf_transfer() {
  let id = (wreg(0x17C) >> 2) & 0x1F
  if (wreg(0x17C) & 0x80) != 0 {
    let d = rf_reg[id]
    wset(0x17E, d & 0xFFFF)
    wset(0x17C, (wreg(0x17C) & 0xFFFC) | ((d >> 16) & 3))
  } else {
    rf_reg[id] = wreg(0x17E) | ((wreg(0x17C) & 3) << 16)
  }
}
-- a TX slot (W_TXBUF_LOC1-3, the command and beacon slots) starting: its frame is "sent" (nothing listens) and
-- completes after WIFI_TX_US microseconds
fn wifi_tx_start() {
  if wifi_tx_left > 0 {
    return
  }
  let req = wreg(0x0B0)
  var slot = -1
  if (req & 1) != 0 and (wreg(0x0A0) & 0x8000) != 0 {
    slot = 0
  } elif (req & 4) != 0 and (wreg(0x0A4) & 0x8000) != 0 {
    slot = 1
  } elif (req & 8) != 0 and (wreg(0x0A8) & 0x8000) != 0 {
    slot = 2
  }
  if slot < 0 {
    return
  }
  wifi_tx_slot = slot
  wifi_tx_left = WIFI_TX_US
  wset(0x0B6, wreg(0x0B6) | (1 << (if slot == 0 then 0 else slot + 1)))
  wset(0x214, 3)                             -- transmitting
  wifi_irq(7)
}
fn wifi_tx_done() {
  let slot = wifi_tx_slot
  let loc = wreg(0x0A0 + slot * 4)
  let at = (loc & 0xFFF) << 1                -- the frame's TX header: its status halfword
  wifi_ram[at & 0x1FFE] = 1
  wifi_ram[(at & 0x1FFE) + 1] = 0
  wset(0x0A0 + slot * 4, loc & 0x7FFF)
  let bit = if slot == 0 then 1 else (if slot == 1 then 4 else 8)
  wset(0x0B0, wreg(0x0B0) & (0xFFFF ^ bit))
  wset(0x0B6, wreg(0x0B6) & (0xFFFF ^ (1 << (if slot == 0 then 0 else slot + 1))))
  wset(0x0B8, 0x0001 | ((if slot == 0 then 0 else slot + 1) << 8))
  wset(0x214, 9)
  wifi_irq(1)
  wifi_tx_start()
}
fn wifi_read16(a: Int) -> Int {
  let x = a & 0x7FFE
  if x >= 0x4000 and x < 0x6000 {
    let r = x & 0x1FFE
    return wifi_ram[r] | (wifi_ram[r + 1] << 8)
  }
  if x >= 0x2000 and x < 0x4000 {
    return 0xFFFF
  }
  let o = x & 0xFFF
  if o == 0x044 {
    wifi_random = (wifi_random & 1) ^ (((wifi_random & 0x3FF) << 1) | (wifi_random >> 10))
    return wifi_random
  }
  if o == 0x0F8 or o == 0x0FA or o == 0x0FC or o == 0x0FE {
    return (wifi_us >> ((o - 0x0F8) * 8)) & 0xFFFF
  }
  if o == 0x0F0 or o == 0x0F2 or o == 0x0F4 or o == 0x0F6 {
    return (wifi_compare >> ((o - 0x0F0) * 8)) & 0xFFFF
  }
  if o == 0x15C {
    return if (wreg(0x158) & 0xF000) == 0x6000 then bb_reg[wreg(0x158) & 0xFF] else 0
  }
  if o == 0x15E or o == 0x180 {
    return 0                                 -- the baseband and RF chips are never busy
  }
  if o == 0x060 {
    let r = wreg(0x058) & 0x1FFE
    let v = wifi_ram[r] | (wifi_ram[r + 1] << 8)
    var n = r + 2
    if n == (wreg(0x052) & 0x1FFE) {
      n = wreg(0x050) & 0x1FFE
    }
    wset(0x058, n)
    if wreg(0x05C) > 0 {
      wset(0x05C, wreg(0x05C) - 1)
      if wreg(0x05C) == 0 {
        wifi_irq(9)
      }
    }
    return v
  }
  if o == 0x0B6 {
    return wreg(0x0B6) & 0x1F
  }
  if o == 0x0BC {
    return wreg(0x0BC) & 3
  }
  return wreg(o)
}
fn wifi_write16(a: Int, v: Int) {
  let x = a & 0x7FFE
  if x >= 0x4000 and x < 0x6000 {
    let r = x & 0x1FFE
    wifi_ram[r] = v & 0xFF
    wifi_ram[r + 1] = (v >> 8) & 0xFF
    return
  }
  if x >= 0x2000 and x < 0x4000 {
    return
  }
  let o = x & 0xFFF
  if (o == 0x000 or o == 0x044 or o == 0x054 or o == 0x0B0 or o == 0x0B6 or o == 0x0B8 or o == 0x15C or o == 0x15E or
      o == 0x180 or o == 0x19C or o == 0x214 or o == 0x268) {
    return                                   -- read-only
  }
  if o == 0x004 {
    let was = wreg(0x004)
    wset(0x004, v & 1)
    if (was & 1) == 0 and (v & 1) != 0 and (wreg(0x036) & 2) != 0 {
      wifi_wake_up()
    }
    if (v & 0x2000) != 0 {
      wset(0x056, 0)
      wset(0x0C0, 0)
      wset(0x0C4, 0)
    }
    if (v & 0x4000) != 0 {
      wset(0x054, 0)
    }
    return
  }
  if o == 0x010 {
    wset(0x010, wreg(0x010) & (0xFFFF ^ v))
    return
  }
  if o == 0x012 {
    let was = wreg(0x010) & wreg(0x012)
    wset(0x012, v)
    if was == 0 and (wreg(0x010) & wreg(0x012)) != 0 {
      request(1, IRQ_WIFI)
    }
    return
  }
  if o == 0x21C {
    let was = wreg(0x010) & wreg(0x012)
    wset(0x010, wreg(0x010) | (v & 0xFBFF))
    if was == 0 and (wreg(0x010) & wreg(0x012)) != 0 {
      request(1, IRQ_WIFI)
    }
    return
  }
  if o == 0x03C {
    wset(0x03C, (wreg(0x03C) & 0x0300) | (v & 2))
    if (v & 2) != 0 and wifi_wake == 0 {
      wifi_wake_up()
    }
    return
  }
  if o == 0x040 {
    if (v & 0x8001) == 0x8001 {
      wset(0x03C, 0x0200)                    -- forced off
      wifi_wake = 0
      wset(0x034, 2)
    } elif (v & 0x8001) == 0x8000 and wifi_wake == 0 {
      wifi_wake_up()                         -- forced on
    }
    wset(0x040, v & 0x8001)
    return
  }
  if o == 0x036 {
    wset(0x036, v & 3)
    return
  }
  if o == 0x158 {
    wset(0x158, v)
    let id = v & 0xFF
    if (v & 0xF000) == 0x5000 and bb_fixed[id] == 0 {
      bb_reg[id] = wreg(0x15A) & 0xFF
    }
    return
  }
  if o == 0x17E {
    wset(0x17E, v)
    rf_transfer()
    return
  }
  if o == 0x0F0 {
    wifi_compare = (wifi_compare & 0x7FFFFFFFFFFF0000) | (v & 0xFC00)
    if (v & 2) != 0 and (wreg(0x0EA) & 1) != 0 {
      wifi_irq(14)
    }
    return
  }
  if o == 0x0F2 or o == 0x0F4 or o == 0x0F6 {
    let s = (o - 0x0F0) * 8
    wifi_compare = (wifi_compare & (0x7FFFFFFFFFFFFFFF ^ (0xFFFF << s))) | ((v & 0xFFFF) << s)
    return
  }
  if o == 0x0F8 or o == 0x0FA or o == 0x0FC or o == 0x0FE {
    let s = (o - 0x0F8) * 8
    wifi_us = (wifi_us & (0x7FFFFFFFFFFFFFFF ^ (0xFFFF << s))) | ((v & 0xFFFF) << s)
    return
  }
  if o == 0x0EA {
    if (v & 2) != 0 {
      wifi_irq(14)
    }
    wset(0x0EA, v & 1)
    return
  }
  if o == 0x0AC {
    wset(0x0B0, wreg(0x0B0) & (0xFFFF ^ v))
    return
  }
  if o == 0x0B4 {                            -- W_TXBUF_RESET: slots no longer ready
    if (v & 1) != 0 {
      wset(0x0A0, wreg(0x0A0) & 0x7FFF)
    }
    if (v & 2) != 0 {
      wset(0x090, wreg(0x090) & 0x7FFF)
    }
    if (v & 4) != 0 {
      wset(0x0A4, wreg(0x0A4) & 0x7FFF)
    }
    if (v & 8) != 0 {
      wset(0x0A8, wreg(0x0A8) & 0x7FFF)
    }
    if (v & 0x40) != 0 {
      wset(0x098, wreg(0x098) & 0x7FFF)
    }
    if (v & 0x80) != 0 {
      wset(0x094, wreg(0x094) & 0x7FFF)
    }
    return
  }
  if o == 0x0AE {
    wset(0x0B0, wreg(0x0B0) | (v & 0xF))
    wifi_tx_start()
    return
  }
  if o == 0x070 {
    let r = wreg(0x068) & 0x1FFE
    wifi_ram[r] = v & 0xFF
    wifi_ram[r + 1] = (v >> 8) & 0xFF
    var n = r + 2
    if n == (wreg(0x074) & 0x1FFE) {
      n = n + ((wreg(0x076) & 0xFFF) << 1)
    }
    wset(0x068, n & 0x1FFE)
    if wreg(0x06C) > 0 {
      wset(0x06C, wreg(0x06C) - 1)
      if wreg(0x06C) == 0 {
        wifi_irq(8)
      }
    }
    return
  }
  if o == 0x030 {
    if (v & 1) != 0 {
      wset(0x054, wreg(0x056))
    }
    wset(0x030, v & 0xFF0E)
    return
  }
  if o == 0x08C {
    wset(0x08C, v & 0x3FF)
    return
  }
  wset(o, v)
}
-- one microsecond of the hardware's time
fn wifi_tick() {
  if wifi_wake > 0 {
    wifi_wake -= 1
    if wifi_wake == 0 {
      wifi_awake()
    }
  }
  if (wreg(0x0E8) & 1) != 0 {
    wifi_us += 1
    let part = wifi_us & 0x3FF
    if (wreg(0x0EA) & 1) != 0 {
      let left = (wreg(0x11C) << 10) | (0x3FF - part)
      if left == wreg(0x110) and wreg(0x110) != 0 {
        wifi_irq(15)                         -- pre-beacon
      }
    }
    if part == 0 {
      if (wreg(0x0EA) & 1) != 0 and (wifi_us & 0x7FFFFFFFFFFFFC00) == wifi_compare {
        wset(0x11C, wreg(0x08C))             -- the beacon count restarts at the interval
        wifi_irq(14)                         -- the beacon timeslot (TBTT)
      }
      if wreg(0x11C) > 0 {
        wset(0x11C, wreg(0x11C) - 1)
        if wreg(0x11C) == 0 {
          wifi_irq(13)                       -- post-beacon
        }
      }
    }
  }
  if wreg(0x10C) > 0 {
    wset(0x10C, wreg(0x10C) - 1)
  }
  if wifi_tx_left > 0 {
    wifi_tx_left -= 1
    if wifi_tx_left == 0 {
      wifi_tx_done()
    }
  }
}
-- machine time: bus cycles turned into microseconds; nothing runs while the radio is off and no wake-up is due
export fn wifi_advance(cycles: Int) {
  if not wifi_powered() and wifi_wake == 0 {
    return
  }
  wifi_acc += cycles * 1000000
  while wifi_acc >= WIFI_BUS_HZ {
    wifi_acc -= WIFI_BUS_HZ
    wifi_tick()
  }
}
