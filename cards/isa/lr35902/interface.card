-- The bus contract of the LR35902 cards, as stubs: what a machine must define for the instruction semantics to
-- link. Each one changes machine state (time at least), so the compiler orders calls to them exactly as written.
-- `cardmodel isa build lr35902` compiles every instruction card against core.card plus these stubs; machines
-- supply the real ones (cards/machine/*).
global bus_effect: Int = 0

fn rd8(a: Int) -> Int {          -- one M-cycle: read the byte at a
  bus_effect += 1
  return 0
}
fn wr8(a: Int, v: Int) {         -- one M-cycle: write v (0..255) at a
  bus_effect += 1
}
fn idle() {                      -- one internal M-cycle (no bus access)
  bus_effect += 1
}
fn idu(a: Int) {                 -- one internal M-cycle in which the 16-bit increment/decrement unit drives a
  bus_effect += 1                -- onto the address bus (the DMG's OAM corruption watches it)
}
fn rd8_idu(a: Int) -> Int {      -- one M-cycle: read the byte at a while the IDU increments or decrements it
  bus_effect += 1
  return 0
}
fn halt() {                      -- HALT (the machine owns IE/IF, so it decides halt vs the HALT bug)
  bus_effect += 1
}
fn stop() {                      -- STOP (speed switch on the CGB, stop mode otherwise)
  bus_effect += 1
}
fn hang() {                      -- an illegal opcode
  bus_effect += 1
}
fn cb_dispatch(op: Int) {        -- generated by the machine builder from the LR35902_CB_* cards
  bus_effect += 1
}
