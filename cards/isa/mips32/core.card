-- MIPS32 Release 2 (little-endian) and the PSP's Allegrex: registers, HI/LO, delay slots and the arithmetic the
-- instruction cards call. Values are unsigned 32-bit words (0 .. 2^32-1); s32 reads one as signed.
-- A machine supplies the bus (rd8/16/32, wr8/16/32), syscall_op(code), break_op(code), exception(code, info),
-- undefined_op(op), and a step function that runs one instruction word:
--
--   next_pc = pc + 4; run the card; a branch sets bpending/btarget; the step then makes the next instruction a
--   delay slot (in_slot, slot_target) and, after the slot, continues at slot_target.
--
-- variant: 0 = MIPS32r2, 1 = Allegrex (cards of the other core are reserved instructions).
const MASK32 = 0xFFFFFFFF
const EXC_ADEL = 4
const EXC_ADES = 5
const EXC_OV = 12
const EXC_TR = 13
array regs: Int[32]
global hi: Int = 0
global lo: Int = 0
global pc: Int = 0
global next_pc: Int = 0
global bpending: Int = 0
global btarget: Int = 0
global in_slot: Int = 0
global slot_target: Int = 0
global variant: Int = 0
global llbit: Int = 0

fn s32(v: Int) -> Int = if v >= 0x80000000 then v - 0x100000000 else v
fn sx16(v: Int) -> Int = if (v & 0x8000) != 0 then (v & 0xFFFF) | 0xFFFF0000 else v & 0xFFFF
fn sx8(v: Int) -> Int = if (v & 0x80) != 0 then (v & 0xFF) | 0xFFFFFF00 else v & 0xFF
fn f_rs(op: Int) -> Int = (op >> 21) & 31
fn f_rt(op: Int) -> Int = (op >> 16) & 31
fn f_rd(op: Int) -> Int = (op >> 11) & 31
fn f_sa(op: Int) -> Int = (op >> 6) & 31
fn simm(op: Int) -> Int = sx16(op & 0xFFFF)
fn gpr(n: Int) -> Int = regs[n]
fn wr(n: Int, v: Int) {
  if n != 0 {
    regs[n] = v & MASK32
  }
}
fn ea(op: Int) -> Int = (regs[(op >> 21) & 31] + sx16(op & 0xFFFF)) & MASK32

-- control flow: a taken branch runs its delay slot first
fn branch(t: Int) {
  bpending = 1
  btarget = t & MASK32
}
fn branch_rel(op: Int) {
  branch(pc + 4 + ((sx16(op & 0xFFFF) << 2) & MASK32))
}
-- a branch-likely that is not taken nullifies its delay slot
fn skip_slot() {
  next_pc = (pc + 8) & MASK32
}
fn link(n: Int) {
  wr(n, pc + 8)
}

-- signed overflow of a 32-bit add/sub: the destination is not written
fn add_ov(a: Int, b: Int, rd: Int) {
  let r = s32(a) + s32(b)
  if r > 0x7FFFFFFF or r < -0x80000000 {
    exception(EXC_OV, 0)
  } else {
    wr(rd, r)
  }
}
fn sub_ov(a: Int, b: Int, rd: Int) {
  let r = s32(a) - s32(b)
  if r > 0x7FFFFFFF or r < -0x80000000 {
    exception(EXC_OV, 0)
  } else {
    wr(rd, r)
  }
}
fn trap_if(c: Bool) {
  if c {
    exception(EXC_TR, 0)
  }
}

-- multiply: 32 x 32 -> 64 without leaving 64-bit signed integers (C's int64 holds every intermediate)
fn mul_lo(a: Int, b: Int) -> Int = ((a & 0xFFFF) * b + ((((a >> 16) * b) & 0xFFFF) << 16)) & MASK32
fn umul_hi(a: Int, b: Int) -> Int {
  let al = a & 0xFFFF
  let ah = a >> 16
  let bl = b & 0xFFFF
  let bh = b >> 16
  let ll = al * bl
  let lh = al * bh
  let hl = ah * bl
  let hh = ah * bh
  let mid = (ll >> 16) + (lh & 0xFFFF) + (hl & 0xFFFF)
  return (hh + (lh >> 16) + (hl >> 16) + (mid >> 16)) & MASK32
}
fn smul_hi(a: Int, b: Int) -> Int {
  var h = umul_hi(a, b)
  if (a & 0x80000000) != 0 {
    h = h - b
  }
  if (b & 0x80000000) != 0 {
    h = h - a
  }
  return h & MASK32
}
-- (hi:lo) += or -= (ph:pl), carrying between the words
fn acc_add(ph: Int, pl: Int) {
  let s = lo + pl
  lo = s & MASK32
  hi = (hi + ph + (s >> 32)) & MASK32
}
fn acc_sub(ph: Int, pl: Int) {
  var d = lo - pl
  var borrow = 0
  if d < 0 {
    d = d + 0x100000000
    borrow = 1
  }
  lo = d
  hi = (hi - ph - borrow) & MASK32
}

-- divide: quotient truncates toward zero; a zero divisor leaves HI and LO unchanged (UNPREDICTABLE in the manual)
fn div_signed(a: Int, b: Int) {
  if b != 0 {
    let x = s32(a)
    let y = s32(b)
    var q = abs(x) // abs(y)
    if (x < 0) != (y < 0) {
      q = 0 - q
    }
    lo = q & MASK32
    hi = (x - q * y) & MASK32
  }
}
fn div_unsigned(a: Int, b: Int) {
  if b != 0 {
    lo = (a // b) & MASK32
    hi = (a % b) & MASK32
  }
}

-- count leading zeros by halving (no data-dependent loop, so the symbolic executor takes it whole)
fn clz32(v: Int) -> Int {
  let t16 = if v <= 0xFFFF then 16 else 0
  let x16 = (v << t16) & MASK32
  let t8 = if x16 <= 0xFFFFFF then 8 else 0
  let x8 = (x16 << t8) & MASK32
  let t4 = if x8 <= 0xFFFFFFF then 4 else 0
  let x4 = (x8 << t4) & MASK32
  let t2 = if x4 <= 0x3FFFFFFF then 2 else 0
  let x2 = (x4 << t2) & MASK32
  let t1 = if x2 <= 0x7FFFFFFF then 1 else 0
  let z = if v == 0 then 1 else 0
  return t16 + t8 + t4 + t2 + t1 + z
}
fn bitrev32(v0: Int) -> Int {
  var v = v0
  var r = 0
  for i in 0 .. 32 {
    r = (r << 1) | (v & 1)
    v = v >> 1
  }
  return r
}
fn bswap32(v: Int) -> Int = ((v & 0xFF) << 24) | ((v & 0xFF00) << 8) | ((v >> 8) & 0xFF00) | ((v >> 24) & 0xFF)
fn rotr32(v: Int, n: Int) -> Int = if n == 0 then v else ((v >> n) | (v << (32 - n))) & MASK32
