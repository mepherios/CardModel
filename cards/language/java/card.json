{
  "category": "language",
  "codegen": {
    "assign": "{name} = {value};",
    "break": "break;",
    "continue": "continue;",
    "declare": "{type} {name} = {value};",
    "else": "}} else {{",
    "empty": ";",
    "end_if": "}}",
    "end_while": "}}",
    "func": "    static {ret} {name}({params}) {{\n{body}    }}\n",
    "harness": {
      "bench_call": "    cm_acc += {truthy};",
      "bench_main": "    public static void main(String[] args) {{\n        long cm_acc = 0;\n        for (long cm_r = 0; cm_r < {reps}; cm_r++) {{\n{calls}        }}\n        System.out.println(cm_acc);\n    }}\n}}\n",
      "main": "    public static void main(String[] args) {{\n{calls}    }}\n}}\n",
      "print": {
        "bool": "System.out.println(\"b:\" + ({e}));",
        "float": "System.out.println(\"f:\" + Double.toString({e}));",
        "int": "System.out.println(\"i:\" + ({e}));"
      },
      "truthy": {
        "bool": "(({e}) ? 1 : 0)",
        "float": "((({e}) > 0.0) ? 1 : 0)",
        "int": "((({e}) != 0) ? 1 : 0)"
      }
    },
    "helpers": {
      "cm_gcd": "    static long cm_gcd(long a, long b) { a = Math.abs(a); b = Math.abs(b); while (b != 0) { long t = a % b; a = b; b = t; } return a; }",
      "cm_ipow": "    static long cm_ipow(long a, long b) { long r = 1; while (b > 0) { if ((b & 1) == 1) r *= a; b >>= 1; if (b > 0) a *= a; } return r; }",
      "cm_max_f": "    static double cm_max_f(double a, double b) { return b > a ? b : a; }",
      "cm_min_f": "    static double cm_min_f(double a, double b) { return b < a ? b : a; }",
      "cm_powmod": "    static long cm_powmod(long a, long b, long m) { if (b < 0) { a = cm_modinv(a, m); b = -b; } long r = Math.floorMod(1L, m); a = Math.floorMod(a, m); while (b > 0) { if ((b & 1) == 1) r = Math.floorMod(r * a, m); a = Math.floorMod(a * a, m); b >>= 1; } return r; }",
      "cm_modinv": "    static long cm_modinv(long a, long m) { long n = Math.abs(m); long r0 = Math.floorMod(a, n), r1 = n, s0 = 1, s1 = 0; while (r1 != 0) { long q = r0 / r1, t = r0 - q * r1; r0 = r1; r1 = t; t = s0 - q * s1; s0 = s1; s1 = t; } if (r0 != 1) throw new ArithmeticException(\"base is not invertible\"); return Math.floorMod(s0, n); }"
    },
    "if": "if ({cond}) {{",
    "import": "import @name@;\n",
    "indent": "    ",
    "lib_epilogue": "}\n",
    "lib_prelude": "@imports@public class CardModule {\n",
    "lit": {
      "false": "false",
      "float": "({v})",
      "int": "({v}L)",
      "true": "true"
    },
    "param": "{type} {name}",
    "prelude": "@imports@public class Main {\n",
    "return": "return {value};",
    "style": "braces",
    "types": {
      "bool": "boolean",
      "float": "double",
      "int": "long"
    },
    "while": "while ({cond}) {{",
    "zero": {
      "bool": "false",
      "float": "0.0",
      "int": "0L"
    }
  },
  "comments": {
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "line": [
      "//"
    ],
    "strings": [
      "\"",
      "'"
    ]
  },
  "extensions": [
    ".java"
  ],
  "family": "c_like",
  "frontend": "cardmodel.engines.frontend_text",
  "frontend_link": "class_per_file",
  "frontend_harness": {
    "arg_cast": "(({type})({v}))",
    "hoist": "^\\s*import\\s",
    "order": "main_first",
    "prelude": "public class Main {\n",
    "qualify": "class\\s+(\\w+)",
    "replace": [
      [
        "^\\s*package\\s+[\\w.]+\\s*;",
        ""
      ],
      [
        "\\bpublic\\s+(final\\s+)?class\\b",
        "class"
      ],
      [
        "\\bstatic\\s+void\\s+main\\s*\\(",
        "static void cm_user_main("
      ]
    ]
  },
  "int_bits": 64,
  "metadata": {
    "version": "1.0.0"
  },
  "name": "java",
  "probe": {
    "kind": "executable",
    "min_version": "11.0",
    "name": "java",
    "version_args": [
      "-version"
    ]
  },
  "provenance": {
    "origin": "cardmodel bootstrap",
    "tool": "tools/bootstrap.py"
  },
  "reserved": [
    "abstract",
    "assert",
    "boolean",
    "break",
    "byte",
    "case",
    "catch",
    "char",
    "class",
    "const",
    "continue",
    "default",
    "do",
    "double",
    "else",
    "enum",
    "extends",
    "final",
    "finally",
    "float",
    "for",
    "goto",
    "if",
    "implements",
    "import",
    "instanceof",
    "int",
    "interface",
    "long",
    "native",
    "new",
    "package",
    "private",
    "protected",
    "public",
    "return",
    "short",
    "static",
    "strictfp",
    "super",
    "switch",
    "synchronized",
    "this",
    "throw",
    "throws",
    "transient",
    "try",
    "void",
    "volatile",
    "while",
    "true",
    "false",
    "null",
    "var",
    "record",
    "yield",
    "Main"
  ],
  "runner": {
    "file": "Main.java",
    "run": [
      "{exe}",
      "{src}"
    ]
  },
  "statement": "Java with long / double, run with the single-file source launcher (java Main.java).",
  "tier": 1
}
