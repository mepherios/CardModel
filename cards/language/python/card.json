{
  "call_runner": "inprocess",
  "category": "language",
  "codegen": {
    "array": {
      "int": "{name} = [0] * {size}",
      "u8": "{name} = bytearray({size})"
    },
    "array_init": {
      "int": "{name} = [{values}]",
      "u8": "{name} = bytearray([{values}])"
    },
    "assign": "{name} = {value}",
    "break": "break",
    "continue": "continue",
    "declare": "{name} = {value}",
    "do": "{value}",
    "else": "else:",
    "empty": "pass",
    "end_if": "",
    "end_while": "",
    "func": "def {name}({params}) -> {ret}:\n{body}\n",
    "global": "{name} = {value}",
    "global_use": "global {names}",
    "harness": {
      "bench_call": "cm_acc += {truthy}",
      "bench_main": "def _cm_main():\n    cm_acc = 0\n    for _cm_r in range({reps}):\n{calls}    print(cm_acc)\n\n_cm_main()\n",
      "main": "def _cm_main():\n{calls}    pass\n\n_cm_main()\n",
      "print": {
        "bool": "print('b:' + ('true' if {e} else 'false'))",
        "float": "print('f:' + repr({e}))",
        "int": "print('i:' + str({e}))"
      },
      "truthy": {
        "bool": "(1 if ({e}) else 0)",
        "float": "(1 if ({e}) > 0.0 else 0)",
        "int": "(1 if ({e}) != 0 else 0)"
      }
    },
    "hoist": false,
    "if": "if {cond}:",
    "import": "import @name@\n",
    "indent": "    ",
    "lib_prelude": "@imports@",
    "lit": {
      "false": "False",
      "float": "{v}",
      "int": "{v}",
      "true": "True"
    },
    "load": {
      "int": "{arr}[{idx}]",
      "u8": "{arr}[{idx}]"
    },
    "native_for_range": "for {var} in range({start}, {stop}, {step}):",
    "param": "{name}: {type}",
    "prelude": "@imports@",
    "return": "return {value}",
    "return_void": "return",
    "store": {
      "int": "{arr}[{idx}] = {value}",
      "u8": "{arr}[{idx}] = ({value}) & 255"
    },
    "style": "indent",
    "types": {
      "bool": "bool",
      "float": "float",
      "int": "int",
      "void": "None"
    },
    "underscore_ok": true,
    "while": "while {cond}:",
    "zero": {
      "bool": "False",
      "float": "0.0",
      "int": "0"
    }
