    "harness": {
      "bench_call": "cm_acc += {truthy}",
      "bench_main": "def _cm_main():\n    cm_acc = 0\n    for _cm_r in range({reps}):\n{calls}    print(cm_acc)\n\n_cm_main()\n",
      "main": "def _cm_main():\n{calls}    pass\n\n_cm_main()\n",
      "print": {
        "bool": "print('b:' + ('true' if {e} else 'false'))",
        "float": "print('f:' + repr({e}))",
        "int": "print('i:' + str({e}))",
        "list[float]": "cm_print_list({e}, 'f')",
        "list[int]": "cm_print_list({e}, 'i')",
        "str": "print('s:' + ' '.join(str(ord(c)) for c in {e}))"
      },
      "truthy": {
        "bool": "(1 if ({e}) else 0)",
        "float": "(1 if ({e}) > 0.0 else 0)",
        "int": "(1 if ({e}) != 0 else 0)"
      }
    },
    "helpers": {
      "cm_acos": "def cm_acos(a):\n    return math.acos(a) if -1.0 <= a <= 1.0 else math.nan",
      "cm_asin": "def cm_asin(a):\n    return math.asin(a) if -1.0 <= a <= 1.0 else math.nan",
      "cm_fmod": "def cm_fmod(a, b):\n    return math.fmod(a, b) if b != 0.0 else math.nan",
      "cm_fsqrt": "def cm_fsqrt(a):\n    return math.sqrt(a) if a >= 0.0 else math.nan",
      "cm_print_list": "def cm_print_list(xs, tag):\n    print('l:' + str(len(xs)))\n    for v in xs:\n        print(tag + ':' + (repr(v) if tag == 'f' else str(v)))\n",
      "cm_s_at": "def cm_s_at(s, i):\n    if not 0 <= i < len(s):\n        raise IndexError('string index out of range')\n    return ord(s[i])",
      "cm_s_chr": "def cm_s_chr(c):\n    if not 0 <= c <= 0x10FFFF or 0xD800 <= c <= 0xDFFF:\n        raise ValueError('not a Unicode scalar value')\n    return chr(c)",
      "cm_s_cmp": "def cm_s_cmp(a, b):\n    return (a > b) - (a < b)",
      "cm_s_ord": "def cm_s_ord(s):\n    if len(s) != 1:\n        raise TypeError('ord of a string whose length is not 1')\n    return ord(s)",
      "cm_s_to_int": "def cm_s_to_int(s):\n    t = s.strip(' \\t\\n\\r\\x0b\\x0c')\n    u = t[1:] if t[:1] in ('+', '-') else t\n    if not u or any(c not in '0123456789' for c in u):\n        raise ValueError('not a decimal integer')\n    return int(t)"
    },
