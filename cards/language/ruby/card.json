{
  "category": "language",
  "codegen": {
    "assign": "{name} = {value}",
    "break": "break",
    "continue": "next",
    "declare": "{name} = {value}",
    "else": "else",
    "empty": "nil",
    "end_if": "end",
    "end_while": "end",
    "func": "def {name}({params})\n{body}end\n",
    "harness": {
      "bench_call": "cm_acc += {truthy}",
      "bench_main": "cm_acc = 0\n{reps}.times do\n{calls}end\nputs(cm_acc)\n",
      "main": "{calls}",
      "print": {
        "bool": "puts(\"b:\" + (({e}) ? \"true\" : \"false\"))",
        "float": "puts(\"f:\" + ({e}).to_s)",
        "int": "puts(\"i:\" + ({e}).to_s)"
      },
      "truthy": {
        "bool": "(({e}) ? 1 : 0)",
        "float": "((({e}) > 0.0) ? 1 : 0)",
        "int": "((({e}) != 0) ? 1 : 0)"
      }
    },
    "helpers": {
      "cm_max_f": "def cm_max_f(a, b)\n  b > a ? b : a\nend",
      "cm_max_i": "def cm_max_i(a, b)\n  b > a ? b : a\nend",
      "cm_min_f": "def cm_min_f(a, b)\n  b < a ? b : a\nend",
      "cm_min_i": "def cm_min_i(a, b)\n  b < a ? b : a\nend"
    },
    "if": "if {cond}",
    "indent": "  ",
    "lib_prelude": "@imports@",
    "lit": {
      "false": "false",
      "float": "({v})",
      "int": "({v})",
      "true": "true"
    },
    "param": "{name}",
    "prelude": "@imports@",
    "return": "return {value}",
    "style": "end",
    "types": {
      "bool": "Boolean",
      "float": "Float",
      "int": "Integer"
    },
    "while": "while {cond}",
    "zero": {
      "bool": "false",
      "float": "0.0",
      "int": "0"
    }
  },
  "comments": {
    "block": [
      [
        "=begin",
        "=end"
      ]
    ],
    "line": [
      "#"
    ],
    "strings": [
      "\"",
      "'"
    ]
  },
  "extensions": [
    ".rb"
  ],
  "family": "ruby",
  "frontend": "cardmodel.engines.frontend_text",
  "int_bits": null,
  "metadata": {
    "version": "1.0.0"
  },
  "name": "ruby",
  "probe": {
    "kind": "executable",
    "name": "ruby",
    "version_args": [
      "--version"
    ]
  },
  "provenance": {
    "origin": "cardmodel bootstrap",
    "tool": "tools/bootstrap.py"
  },
  "reserved": [
    "BEGIN",
    "END",
    "alias",
    "and",
    "begin",
    "break",
    "case",
    "class",
    "def",
    "defined",
    "do",
    "else",
    "elsif",
    "end",
    "ensure",
    "false",
    "for",
    "if",
    "in",
    "module",
    "next",
    "nil",
    "not",
    "or",
    "redo",
    "rescue",
    "retry",
    "return",
    "self",
    "super",
    "then",
    "true",
    "undef",
    "unless",
    "until",
    "when",
    "while",
    "yield",
    "puts"
  ],
  "runner": {
    "file": "main.rb",
    "run": [
      "{exe}",
      "{src}"
    ]
  },
  "statement": "Ruby: Integer is unbounded with floor division, like Python.",
  "tier": 1
}
