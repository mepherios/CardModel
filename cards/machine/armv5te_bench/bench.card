-- A bench for one ARM or Thumb instruction at a time: 64 KiB of flat memory (mirrored over the address space),
-- a trace of every access (kind 1-3 read 8/16/32 bits, 4-6 write), and stub SWI / undefined / coprocessor
-- hooks that record what they were asked. The host gives the instruction word; nothing is fetched.
const TRACE_MAX = 64
global ntrace: Int = 0
global swi_calls: Int = 0
global swi_last: Int = -1
global undef_calls: Int = 0
global cp_last: Int = -1
global cp_value: Int = 0
array mem: Byte[0x10000]
array trace_kind: Int[TRACE_MAX]
array trace_addr: Int[TRACE_MAX]
array trace_val: Int[TRACE_MAX]

fn note(kind: Int, a: Int, v: Int) {
  if ntrace < TRACE_MAX {
    trace_kind[ntrace] = kind
    trace_addr[ntrace] = a & MASK32
    trace_val[ntrace] = v
    ntrace += 1
  }
}
fn rd8(a: Int) -> Int {
  let v = mem[a & 0xFFFF]
  note(1, a, v)
  return v
}
fn rd16(a: Int) -> Int {
  let v = mem[a & 0xFFFF] | (mem[(a + 1) & 0xFFFF] << 8)
  note(2, a, v)
  return v
}
fn rd32(a: Int) -> Int {
  let v = mem[a & 0xFFFF] | (mem[(a + 1) & 0xFFFF] << 8) | (mem[(a + 2) & 0xFFFF] << 16) | (mem[(a + 3) & 0xFFFF] << 24)
  note(3, a, v)
  return v
}
fn wr8(a: Int, v: Int) {
  mem[a & 0xFFFF] = v
  note(4, a, v & 0xFF)
}
fn wr16(a: Int, v: Int) {
  mem[a & 0xFFFF] = v
  mem[(a + 1) & 0xFFFF] = v >> 8
  note(5, a, v & 0xFFFF)
}
fn wr32(a: Int, v: Int) {
  mem[a & 0xFFFF] = v
  mem[(a + 1) & 0xFFFF] = v >> 8
  mem[(a + 2) & 0xFFFF] = v >> 16
  mem[(a + 3) & 0xFFFF] = v >> 24
  note(6, a, v & MASK32)
}
fn swi(n: Int) {
  swi_calls += 1
  swi_last = n
}
fn undefined_op(op: Int) {
  undef_calls += 1
}
fn cp_read(op: Int) -> Int {
  cp_last = op
  return cp_value
}
fn cp_write(op: Int, v: Int) {
  cp_last = op
  cp_value = v
}
export fn run_one(op: Int) {
  ntrace = 0
  if thumb() {
    next_pc = (pc + 2) & MASK32
    thumb_exec(op)
  } else {
    next_pc = (pc + 4) & MASK32
    let c = (op >> 28) & 0xF
    if c == 15 {
      arm_uncond(op)
    } elif cond_ok(c) {
      arm_exec(op)
    }
  }
  pc = next_pc
}
