-- The Game Boy / Game Boy Color: the LR35902 instruction cards plus the hardware cards, one module. The host
-- (the effect shell) loads the ROM into `rom`, configures the cartridge from the header, calls power_on, then
-- run_frame once per frame; it reads `frame` (RGB888), drains `audio`, sets `buttons`, saves `cram`.
const FRAME_DOTS = 70224
const COMPAT_DIV = card.hardware.gb_cgb.dmg_compat.div_counter
export global model: Int = 0
export global frame_deadline: Int = 0
export global instructions: Int = 0
export global interpreted: Int = 0        -- of those, run by the interpreter one at a time (the rest: lifted blocks)
export global interpreted_ram: Int = 0    -- of those, from RAM (code the cartridge copied there)
-- lifted code (cardmodel/machine/lift.py replaces run_block with a switch over the ROM's lifted blocks)
export global lifted_on: Int = 0
export global block_runs: Int = 0
export global profiling: Int = 0
global fall_pc: Int = -1
export array seen: Byte[0x100000]        -- 1 bit per ROM byte: an instruction started there
export array entries: Byte[0x100000]     -- 1 bit per ROM byte: reached other than by falling through
export array ram_seen: Byte[0x1000]      -- 1 bit per address 8000-FFFF: an instruction started there (code in RAM)
export array ram_code: Byte[0x8000]      -- each RAM instruction's bytes as it last ran (what the lifter reads)

fn full_sync() {
  sync_components(now)
}
-- every component up to now, the PPU up to ppu_until
fn sync_components(ppu_until: Int) {
  timer_sync()
  dma_sync()
  let t = now
  now = ppu_until
  ppu_sync()
  now = t
  serial_sync()
  apu_sync()
  var t = ppu_irq_next()
  let tn = timer_next()
  if tn < t {
    t = tn
  }
  let sn = serial_next()
  if sn < t {
    t = sn
  }
  if frame_deadline < t {
    t = frame_deadline
  }
  next_event = t
}
-- skip whole M-cycles up to dot t (HALT and STOP wait this way)
fn skip_to(t: Int) {
  if t > now {
    let n = (t - now + md - 1) // md
    now += n * md
  }
}
-- the instruction boundary: sync when an event is due, stalls, STOP, HALT, interrupt dispatch; true when the
-- CPU should now execute an instruction. A running CPU samples interrupts at the boundary, and a PPU interrupt
-- reaches it a little after the dot it is raised on: one raised exactly at this boundary is taken at the next
-- (mooneye di_timing, halt_ime1_timing2). A halted CPU sees it at once and spends one M-cycle waking up.
fn boundary() -> Bool {
  if now >= next_event {
    if halted != 0 or stopped != 0 {
      full_sync()
    } else {
      sync_components(now - 1)
    }
  }
  if stall > 0 {
    now += stall
    stall = 0
    return false
  }
  if stopped != 0 {
    skip_to(next_event)
    return false
  }
  let pend = pending_irq()
  if halted != 0 {
    if pend == 0 {
      skip_to(next_event)
      return false
    }
    halted = 0
    idle()
  }
  if ime != 0 and pend != 0 {
    dispatch_irq()
    fall_pc = -1
    return false
  }
  return true
}
fn rom_phys(pc: Int) -> Int {
  if pc < 0x4000 {
    return (rom_off0 | pc) & rom_mask
  }
  return (rom_off1 | (pc & 0x3FFF)) & rom_mask
}
-- a block key: the ROM byte offset and which half of the address space it runs in
fn block_key(pc: Int) -> Int = (rom_phys(pc) << 1) | (pc >> 14)
-- run the lifted block that has the instruction at key, from that instruction (single: that one only, as the
-- interpreter would); 0 when no block has it
fn run_block(key: Int, single: Int) -> Int {
  return 0
}
-- the byte at a as code there reads, without touching the hardware (RAM code's profile and guards)
export fn code_byte(a: Int) -> Int {
  if a >= 0xFF80 and a < 0xFFFF {
    return hram[a - 0xFF80]
  }
  if a >= 0xFE00 {
    return 0xFF
  }
  return peek8(a)
}
fn ram_mark() {
  let r = PC - 0x8000
  ram_seen[r >> 3] = ram_seen[r >> 3] | (1 << (r & 7))
  let n = op_bytes[code_byte(PC)]
  for j in 0 .. n {
    ram_code[(r + j) & 0x7FFF] = code_byte((PC + j) & 0xFFFF)
  }
}
-- run the lifted instruction at RAM address pc when RAM still holds the bytes it was lifted from; 0 otherwise
fn run_ram(pc: Int, single: Int) -> Int {
  return 0
}
fn profile_mark() {
  let phys = rom_phys(PC)
  seen[phys >> 3] = seen[phys >> 3] | (1 << (phys & 7))
  if PC != fall_pc {
    entries[phys >> 3] = entries[phys >> 3] | (1 << (phys & 7))
  }
}
fn interp_one() {
  if profiling != 0 {
    if PC < 0x8000 {
      profile_mark()
    } else {
      ram_mark()
    }
  }
  let pc0 = PC
  let op = fetch8()
  exec_op(op)
  instructions += 1
  interpreted += 1
  if pc0 >= 0x8000 {
    interpreted_ram += 1
  }
  fall_pc = (pc0 + op_bytes[op]) & 0xFFFF
  if ime_delay != 0 {
    ime_delay -= 1
    if ime_delay == 0 {
      ime = 1
    }
  }
}
export fn step() {
  if not boundary() {
    return
  }
  -- a whole block is the instructions it replaces only while nothing outside it is waiting for an instruction
  -- boundary: after the sync that ended the frame (run_frame stops after one more instruction) and right after
  -- EI the block runs one instruction (single); after a HALT bug the next fetch repeats a byte (interpreter)
  if lifted_on != 0 and halt_bug == 0 {
    var single = 0
    if frame_done != 0 or ime_delay != 0 {
      single = 1
    }
    var ran = 0
    if PC < 0x8000 {
      ran = run_block(block_key(PC), single)
    } else {
      ran = run_ram(PC, single)
    }
    if ran != 0 {
      block_runs += 1
      fall_pc = -1
      return
    }
  }
  interp_one()
}
-- run until the PPU enters V-blank (or one frame of time when the LCD is off); returns the dots that passed
export fn run_frame() -> Int {
  let start = now
  frame_done = 0
  frame_deadline = start + FRAME_DOTS + DOTS_PER_LINE
  next_event = now
  while frame_done == 0 and now < frame_deadline and locked == 0 {
    step()
  }
  full_sync()
  return now - start
}
export fn run_dots(n: Int) {
  frame_deadline = now + n
  next_event = now
  while now < frame_deadline and locked == 0 {
    step()
  }
  full_sync()
}
fn clear_memory() {
  for i in 0 .. 0x8000 {
    wram[i] = 0
  }
  for i in 0 .. 0x4000 {
    vram[i] = 0
  }
  for i in 0 .. 0xA0 {
    oam[i] = 0
  }
  for i in 0 .. 0x80 {
    hram[i] = 0
  }
  for i in 0 .. 0x30 {
    nr[i] = 0
  }
}
-- the state after the boot ROM (which is not used: it is not ours to ship). A CGB's boot ROM picks the mode
-- from the cartridge header: CGB mode, or DMG compatibility mode for a DMG cartridge (cgb_boot_mode).
export fn power_on(want_cgb: Int) {
  cgb = want_cgb
  model = want_cgb
  cgb_boot_mode(want_cgb)
  if cgb_mode != 0 {
    A = 0x11
    F = 0x80
    B = 0x00
    C = 0x00
    D = 0xFF
    E = 0x56
    H = 0x00
    L = 0x0D
  } elif cgb != 0 {
    -- DMG compatibility mode (mooneye boot_regs-cgb): B is the boot ROM's title checksum, which also picks HL
    A = 0x11
    F = 0x80
    B = title_checksum()
    C = 0x00
    D = 0x00
    E = 0x08
    let hl = if B == 0x43 or B == 0x58 then 0x991A else 0x007C
    H = hl >> 8
    L = hl & 0xFF
  } else {
    A = 0x01
    F = 0xB0
    B = 0x00
    C = 0x13
    D = 0x00
    E = 0xD8
    H = 0x01
    L = 0x4D
  }
  SP = 0xFFFE
  PC = 0x0100
  ime = 0
  ime_delay = 0
  halted = 0
  halt_bug = 0
  locked = 0
  now = 0
  md = 4
  ds = 0
  ie_reg = 0
  if_reg = 0x01
  div_counter = 0xABCC
  if cgb_mode != 0 {
    div_counter = 0x1EA0
  } elif cgb != 0 {
    div_counter = COMPAT_DIV
  }
  timer_last = 0
  tima = 0
  tma = 0
  tac = 0
  tima_reload = -1
  lcdc = 0x91
  stat_sel = 0
  ly = 0
  lyc = 0
  scy = 0
  scx = 0
  wy = 0
  wx = 0
  bgp = 0xFC
  obp0 = 0xFF
  obp1 = 0xFF
  -- the CGB boot ROM hands over in V-blank (games touch VRAM at once: Trouballs detects the Color that way);
  -- the DMG one at the start of line 0
  if cgb != 0 {
    ly = SCREEN_H
    mode = 1
    line_start = 0
    ppu_next = DOTS_PER_LINE
  } else {
    mode = 2
    line_start = 0
    ppu_next = MODE2_DOTS
  }
  win_line = 0
  stat_line = 0
  vbk = 0
  wram_bank = 1
  svbk = 0
  key1 = 0
  -- P1 reads 0xCF, or 0xFF after the compatibility path (mooneye boot_hwio-C)
  p1_sel = if cgb != 0 and cgb_mode == 0 then 0x30 else 0x00
  sb = 0
  sc = 0x7E
  serial_end = -1
  dma_active = 0
  dma_reg = 0xFF
  hdma_on = 0
  hdma_len = 0x7F
  stall = 0
  stopped = 0
  apu_last = 0
  fs_next = FS_DOTS - (div_counter & (FS_DOTS - 1))
  fs_step = 0
  apu_on = 1
  clear_memory()
  nr[0x10 - 0x10] = 0x80
  nr[0x11 - 0x10] = 0xBF
  nr[0x12 - 0x10] = 0xF3
  nr[0x14 - 0x10] = 0xBF
  nr[0x16 - 0x10] = 0x3F
  nr[0x19 - 0x10] = 0xBF
  nr[0x1A - 0x10] = 0x7F
  nr[0x1B - 0x10] = 0xFF
  nr[0x1C - 0x10] = 0x9F
  nr[0x1E - 0x10] = 0xBF
  nr[0x20 - 0x10] = 0xFF
  nr[0x23 - 0x10] = 0xBF
  nr[0x24 - 0x10] = 0x77
  nr[0x25 - 0x10] = 0xF3
  c1_on = 1
  ram_on = 0
  bank_lo = 1
  bank_hi = 0
  mbc_mode = 0
  rtc_sel = 0
  rtc_last = 0
  mbc_map()
  frame_done = 0
  frames = 0
  instructions = 0
  serial_n = 0
  audio_n = 0
  for i in 0 .. 69120 {
    frame[i] = 0xFF
  }
  if cgb_mode != 0 {
    for i in 0 .. 64 {
      bgpal[i] = 0xFF
    }
  } elif cgb != 0 {
    boot_dmg_compat()
  }
  next_event = 0
}
-- the debugger's view of the bus (no side effects, no time)
export fn peek(a: Int) -> Int {
  if a >= 0xFF00 {
    return 0
  }
  return peek8(a)
}
