-- A bench for one MIPS instruction at a time: 64 KiB of flat little-endian memory (mirrored over the address
-- space), a trace of every access (kind 1-3 read 8/16/32 bits, 4-6 write), and hooks that record what they were
-- asked. The host gives the instruction word; nothing is fetched. run_one is the step every MIPS machine makes:
-- a branch's delay slot runs before the jump.
const TRACE_MAX = 64
global ntrace: Int = 0
global sys_calls: Int = 0
global sys_last: Int = -1
global brk_calls: Int = 0
global exc_calls: Int = 0
global exc_last: Int = -1
global exc_info: Int = 0
global undef_calls: Int = 0
array mem: Byte[0x10000]
array trace_kind: Int[TRACE_MAX]
array trace_addr: Int[TRACE_MAX]
array trace_val: Int[TRACE_MAX]

fn note(kind: Int, a: Int, v: Int) {
  if ntrace < TRACE_MAX {
    trace_kind[ntrace] = kind
    trace_addr[ntrace] = a & MASK32
    trace_val[ntrace] = v
    ntrace += 1
  }
}
fn rd8(a: Int) -> Int {
  let v = mem[a & 0xFFFF]
  note(1, a, v)
  return v
}
fn rd16(a: Int) -> Int {
  let v = mem[a & 0xFFFF] | (mem[(a + 1) & 0xFFFF] << 8)
  note(2, a, v)
  return v
}
fn rd32(a: Int) -> Int {
  let v = mem[a & 0xFFFF] | (mem[(a + 1) & 0xFFFF] << 8) | (mem[(a + 2) & 0xFFFF] << 16) | (mem[(a + 3) & 0xFFFF] << 24)
  note(3, a, v)
  return v
}
fn wr8(a: Int, v: Int) {
  mem[a & 0xFFFF] = v
  note(4, a, v & 0xFF)
}
fn wr16(a: Int, v: Int) {
  mem[a & 0xFFFF] = v
  mem[(a + 1) & 0xFFFF] = v >> 8
  note(5, a, v & 0xFFFF)
}
fn wr32(a: Int, v: Int) {
  mem[a & 0xFFFF] = v
  mem[(a + 1) & 0xFFFF] = v >> 8
  mem[(a + 2) & 0xFFFF] = v >> 16
  mem[(a + 3) & 0xFFFF] = v >> 24
  note(6, a, v & MASK32)
}
fn syscall_op(code: Int) {
  sys_calls += 1
  sys_last = code
}
fn break_op(code: Int) {
  brk_calls += 1
}
fn exception(code: Int, info: Int) {
  exc_calls += 1
  exc_last = code
  exc_info = info
}
fn undefined_op(op: Int) {
  undef_calls += 1
}
export fn run_one(op: Int) {
  ntrace = 0
  let was = in_slot
  let t = slot_target
  in_slot = 0
  next_pc = (pc + 4) & MASK32
  mips_exec(op)
  if bpending != 0 {
    bpending = 0
    in_slot = 1
    slot_target = btarget
  }
  if was != 0 {
    pc = t
  } else {
    pc = next_pc
  }
}
