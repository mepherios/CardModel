{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VersionedCardMetadata",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "previous_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version_bump_reason": {
      "type": "string"
    }
  }
}