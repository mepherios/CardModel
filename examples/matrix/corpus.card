-- The pair-matrix corpus, written once in the card language. examples/matrix/corpus.py is the same functions
-- hand-ported to Python (and later to each new source language). `cardmodel matrix` lifts every port through its
-- frontend, emits every target, runs it, and checks that ports of one function agree with each other.
module corpus

fn floordiv_neg(a: Int, b: Int) -> Int {
  if b == 0 { return 0 }
  return a // b
}

fn mod_neg(a: Int, b: Int) -> Int {
  if b == 0 { return 0 }
  return a % b
}

fn true_div(a: Int, b: Int) -> Float {
  if b == 0 { return 0.0 }
  return float(a) / float(b)
}

fn shifts(a: Int, s: Int) -> Int {
  var t = s % 8
  return (a >> t) + (a << t)
}

fn bit_ops(a: Int, b: Int) -> Int = (a & b) ^ (a | (-1 - b))

fn powmod3(a: Int, e: Int, m: Int) -> Int {
  if m <= 1 { return 0 }
  return pow(a, abs(e), m)
}

fn legendre(a: Int, p0: Int) -> Int {
  var p = abs(p0) % 50
  if p < 3 or p % 2 == 0 { return 0 }
  var d = 3
  while d * d <= p {
    if p % d == 0 { return 0 }
    d += 2
  }
  var r = pow(a, (p - 1) // 2, p)
  if r == p - 1 { return -1 }
  return r
}

fn gcd_neg(a: Int, b: Int) -> Int = gcd(a, b)

fn cube(a: Int) -> Int = a ** 3

fn chain_cmp(a: Int, b: Int, c: Int) -> Bool = a < b and b <= c

fn short_circuit(a: Int, b: Int) -> Bool = (b != 0 and a % b == 0) or a == b

fn ternary(a: Int, b: Int) -> Int = if a > b then a else -b

fn loop_step(n: Int) -> Int requires 0 <= n, n <= 30 {
  var total = 0
  var i = n
  while i > -n {
    total += i * i
    i -= 3
  }
  return total
}

fn nested_loops(n: Int) -> Int requires 0 <= n, n <= 30 {
  var count = 0
  for i in 0 .. n {
    for j in 0 .. i {
      if (i + j) % 3 == 0 { continue }
      if j > 7 { break }
      count += i ^ j
    }
  }
  return count
}

fn not_bool(a: Int, flag: Bool) -> Bool = not flag or a > 0

fn bool_arith(p: Bool, q: Bool) -> Int {
  var t = 0
  if p { t += 1 }
  if q { t += 2 }
  return t
}

fn big_product(a: Int, b: Int) -> Int = a * b * 1000003

fn swap_loop(n: Int) -> Int requires 0 <= n, n <= 30 {
  var a = 0
  var b = 1
  for i in 0 .. n {
    (a, b) = (b, a + b)
  }
  return a % 1000
}

fn helper(x: Int) -> Int = x * 2 + 1

fn calls_helper(n: Int) -> Int = helper(helper(n)) - helper(-n)

fn recur(n: Int) -> Int requires n <= 30 {
  if n <= 0 { return 0 }
  return n + recur(n - 2)
}

fn mixed(a: Int, x: Float) -> Float = float(a) * x + float(a) / 3.0 - float(a) * 0.5

fn float_eq(x: Float) -> Bool = x * 3.0 / 3.0 == x

fn int_of_float(x: Float) -> Int = int(x)

-- domain edges: the IR (and C, Go, Java, JS...) give NaN where Python's math and Ruby's Math raise
fn sqrt_edge(x: Float) -> Float = op.FSQRT(x) + 1.0
fn acos_edge(x: Float) -> Float = op.ACOS(x / 50.0)
fn asin_edge(x: Float) -> Float = op.ASIN(x / 50.0)
fn fmod_edge(x: Float, y: Float) -> Float = op.FMOD(x, if y > 50.0 then 0.0 else y)
