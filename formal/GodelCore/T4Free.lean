import GodelCore.T1Lattice

set_option linter.unusedSimpArgs false

/-!
# T4: merging generators keeps the factor layer free; an equation between products does not

`Gen x y` is the congruence on models generated by one relation `x ≈ y`.

* Merging two concepts that name the same thing (`x = basis a`, `y = basis b`) is harmless: two
  models are congruent exactly when they agree after moving `a`'s exponent onto `b`
  (`gen_basis_iff`), and those merged models are exactly the vectors without `a`, the free monoid
  on the remaining concepts (`merge_image`).
* An equation between products, `a · b = c · d` with four distinct concepts, breaks unique
  factorization: the four classes stay pairwise distinct atoms, yet `a · b` and `c · d` are the
  same element (`two_factorizations`). In a free commutative monoid a product of two atoms has one
  factorization (`basis_pair_unique`), so this quotient is not free. Such equations belong in the
  transformation layer as rules with proofs, never in the factor layer.
-/

namespace GodelCore

/-- The congruence generated by `x ≈ y`. -/
inductive Gen (x y : Vec) : Vec → Vec → Prop
  | base : Gen x y x y
  | refl (u : Vec) : Gen x y u u
  | symm {u v : Vec} : Gen x y u v → Gen x y v u
  | trans {u v w : Vec} : Gen x y u v → Gen x y v w → Gen x y u w
  | mul {u v : Vec} (w : Vec) : Gen x y u v → Gen x y (mul u w) (mul v w)

theorem Gen.mul_left {x y u v : Vec} (w : Vec) (h : Gen x y u v) :
    Gen x y (GodelCore.mul w u) (GodelCore.mul w v) := by
  rw [mul_comm w u, mul_comm w v]; exact Gen.mul w h

/-- Merging concept `a` into concept `b`: `a`'s exponent moves onto `b`. -/
def merge (a b : Nat) (v : Vec) : Vec := fun i => if i = a then 0 else if i = b then v a + v b else v i

theorem merge_mul (a b : Nat) (u v : Vec) : merge a b (mul u v) = mul (merge a b u) (merge a b v) := by
  funext i
  simp only [merge, mul]
  by_cases h1 : i = a
  · simp [h1]
  · by_cases h2 : i = b
    · subst h2; simp [h1]; omega
    · simp [h1, h2]

theorem merge_basis (a b : Nat) (hab : a ≠ b) : merge a b (basis a) = merge a b (basis b) := by
  funext i
  simp only [merge, basis]
  by_cases h1 : i = a <;> by_cases h2 : i = b <;> simp [h1, h2, hab, Ne.symm hab]

theorem merge_of_zero {a b : Nat} {u : Vec} (h : u a = 0) : merge a b u = u := by
  funext i
  simp only [merge]
  by_cases h1 : i = a
  · subst h1; simp [h]
  · by_cases h2 : i = b
    · subst h2; simp [h1, h]
    · simp [h1, h2]

/-- Every model is congruent to its merged form. -/
theorem gen_merge (a b : Nat) (hab : a ≠ b) :
    ∀ k (u : Vec), u a = k → Gen (basis a) (basis b) u (merge a b u) := by
  intro k
  induction k with
  | zero => intro u hu; rw [merge_of_zero hu]; exact Gen.refl u
  | succ k ih =>
    intro u hu
    let u' : Vec := fun i => if i = a then k else u i
    have hu' : u' a = k := by simp [u']
    have hsplit : u = mul u' (basis a) := by
      funext i
      simp only [mul, basis, u']
      by_cases h1 : i = a
      · subst h1; simp [hu]
      · simp [h1]
    have hmerge : merge a b u = mul (merge a b u') (basis b) := by
      funext i
      simp only [merge, mul, basis, u']
      by_cases h1 : i = a
      · subst h1; simp [hab]
      · by_cases h2 : i = b
        · subst h2; simp [h1, hu] <;> omega
        · simp [h1, h2]
    have step1 : Gen (basis a) (basis b) (mul u' (basis a)) (mul (merge a b u') (basis a)) :=
      Gen.mul (basis a) (ih u' hu')
    have step2 : Gen (basis a) (basis b) (mul (merge a b u') (basis a)) (mul (merge a b u') (basis b)) :=
      Gen.mul_left (merge a b u') Gen.base
    rw [← hsplit] at step1
    rw [hmerge]
    exact Gen.trans step1 step2

/-- T4, merging: two models are congruent under `a ≈ b` exactly when their merged forms agree. -/
theorem gen_basis_iff (a b : Nat) (hab : a ≠ b) (u v : Vec) :
    Gen (basis a) (basis b) u v ↔ merge a b u = merge a b v := by
  constructor
  · intro h
    induction h with
    | base => exact merge_basis a b hab
    | refl => rfl
    | symm _ ih => exact ih.symm
    | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
    | mul w _ ih => rw [merge_mul, merge_mul, ih]
  · intro h
    have hu := gen_merge a b hab (u a) u rfl
    have hv := gen_merge a b hab (v a) v rfl
    rw [h] at hu
    exact Gen.trans hu (Gen.symm hv)

/-- T4, merging: the merged models are exactly the vectors without concept `a`, which form the free
commutative monoid on the remaining concepts. -/
theorem merge_image (a b : Nat) (w : Vec) : (∃ u, merge a b u = w) ↔ w a = 0 := by
  constructor
  · rintro ⟨u, rfl⟩; simp [merge]
  · intro h; exact ⟨w, merge_of_zero h⟩

section product_equation

variable {a b c d : Nat}

/-- What `a · b ≈ c · d` cannot change: four coordinate sums and every other coordinate. -/
def Inv4 (a b c d : Nat) (u v : Vec) : Prop :=
  u a + u c = v a + v c ∧ u a + u d = v a + v d ∧ u b + u c = v b + v c ∧ u b + u d = v b + v d ∧
  ∀ i, i ≠ a → i ≠ b → i ≠ c → i ≠ d → u i = v i

theorem gen4_inv (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    {u v : Vec} (h : Gen (mul (basis a) (basis b)) (mul (basis c) (basis d)) u v) : Inv4 a b c d u v := by
  induction h with
  | base =>
    refine ⟨?_, ?_, ?_, ?_, fun i h1 h2 h3 h4 => ?_⟩ <;>
      simp [mul, basis, hab, hac, had, hbc, hbd, hcd, Ne.symm hab, Ne.symm hac, Ne.symm had, Ne.symm hbc,
        Ne.symm hbd, Ne.symm hcd, *]
  | refl => exact ⟨rfl, rfl, rfl, rfl, fun _ _ _ _ _ => rfl⟩
  | symm _ ih =>
    obtain ⟨h1, h2, h3, h4, h5⟩ := ih
    exact ⟨h1.symm, h2.symm, h3.symm, h4.symm, fun i p q r s => (h5 i p q r s).symm⟩
  | trans _ _ ih₁ ih₂ =>
    obtain ⟨h1, h2, h3, h4, h5⟩ := ih₁
    obtain ⟨g1, g2, g3, g4, g5⟩ := ih₂
    exact ⟨h1.trans g1, h2.trans g2, h3.trans g3, h4.trans g4, fun i p q r s => (h5 i p q r s).trans (g5 i p q r s)⟩
  | mul w _ ih =>
    obtain ⟨h1, h2, h3, h4, h5⟩ := ih
    refine ⟨?_, ?_, ?_, ?_, fun i p q r s => ?_⟩ <;> simp only [mul]
    · omega
    · omega
    · omega
    · omega
    · rw [h5 i p q r s]

/-- An atom of the quotient: not the unit, and only trivially a product. -/
def IsAtom (R : Vec → Vec → Prop) (x : Vec) : Prop :=
  ¬R x one ∧ ∀ u w, R x (mul u w) → R u one ∨ R w one

/-- The zero vector is the only model congruent to the unit. -/
theorem gen4_one (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    {u : Vec} (h : Gen (mul (basis a) (basis b)) (mul (basis c) (basis d)) u one) : u = one := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := gen4_inv hab hac had hbc hbd hcd h
  simp only [one] at h1 h2 h3 h4 h5
  funext i
  simp only [one]
  by_cases ha : i = a
  · subst ha; omega
  · by_cases hb : i = b
    · subst hb; omega
    · by_cases hc : i = c
      · subst hc; omega
      · by_cases hd : i = d
        · subst hd; omega
        · exact h5 i ha hb hc hd

/-- If every coordinate of `u + w` is that of the basis vector `e_x`, one factor is the unit. -/
theorem split_basis {x : Nat} {u w : Vec} (h : ∀ i, u i + w i = basis x i) : u = one ∨ w = one := by
  have hx := h x
  simp [basis] at hx
  have hz : ∀ i, i ≠ x → u i = 0 ∧ w i = 0 := by
    intro i hi
    have := h i
    simp [basis, hi] at this
    omega
  by_cases hu : u x = 0
  · left; funext i; simp only [one]
    by_cases hi : i = x
    · subst hi; exact hu
    · exact (hz i hi).1
  · right; funext i; simp only [one]
    by_cases hi : i = x
    · subst hi; omega
    · exact (hz i hi).2

/-- The relation `a · b ≈ c · d`. -/
abbrev R4 (a b c d : Nat) : Vec → Vec → Prop := Gen (mul (basis a) (basis b)) (mul (basis c) (basis d))

/-- A model with the four sums and the other coordinates of `e_x` (`x` one of the four) is `e_x`. -/
theorem inv4_eq_basis (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    {x : Nat} (hx : x = a ∨ x = b ∨ x = c ∨ x = d) {s : Vec} (h : Inv4 a b c d (basis x) s) :
    s = basis x := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  have hv : (basis x a = 1 ∧ basis x b = 0 ∧ basis x c = 0 ∧ basis x d = 0) ∨
      (basis x a = 0 ∧ basis x b = 1 ∧ basis x c = 0 ∧ basis x d = 0) ∨
      (basis x a = 0 ∧ basis x b = 0 ∧ basis x c = 1 ∧ basis x d = 0) ∨
      (basis x a = 0 ∧ basis x b = 0 ∧ basis x c = 0 ∧ basis x d = 1) := by
    rcases hx with hx | hx | hx | hx <;> subst hx <;>
      simp [basis, hab, hac, had, hbc, hbd, hcd, Ne.symm hab, Ne.symm hac, Ne.symm had, Ne.symm hbc,
        Ne.symm hbd, Ne.symm hcd]
  funext i
  by_cases ia : i = a
  · subst ia; omega
  · by_cases ib : i = b
    · subst ib; omega
    · by_cases ic : i = c
      · subst ic; omega
      · by_cases id : i = d
        · subst id; omega
        · exact (h5 i ia ib ic id).symm

/-- In the quotient by `a · b ≈ c · d`, the four concepts are pairwise distinct atoms, and `a · b`
equals `c · d`: one element with two factorizations into atoms. -/
theorem two_factorizations (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d)
    (hcd : c ≠ d) :
    R4 a b c d (mul (basis a) (basis b)) (mul (basis c) (basis d)) ∧
    IsAtom (R4 a b c d) (basis a) ∧ IsAtom (R4 a b c d) (basis b) ∧ IsAtom (R4 a b c d) (basis c) ∧
    IsAtom (R4 a b c d) (basis d) ∧
    ¬R4 a b c d (basis a) (basis c) ∧ ¬R4 a b c d (basis a) (basis d) ∧ ¬R4 a b c d (basis b) (basis c) ∧
    ¬R4 a b c d (basis b) (basis d) ∧ ¬R4 a b c d (basis a) (basis b) ∧ ¬R4 a b c d (basis c) (basis d) := by
  have inv := @gen4_inv a b c d hab hac had hbc hbd hcd
  have atom : ∀ x, x = a ∨ x = b ∨ x = c ∨ x = d → IsAtom (R4 a b c d) (basis x) := by
    intro x hx
    refine ⟨fun h => ?_, fun u w h => ?_⟩
    · have := congrFun (gen4_one hab hac had hbc hbd hcd h) x
      simp [basis, one] at this
    · have hs := inv4_eq_basis hab hac had hbc hbd hcd hx (inv h)
      have hall : ∀ i, u i + w i = basis x i := fun i => by
        have := congrFun hs i
        simpa [mul] using this
      rcases split_basis hall with hu | hw
      · left; rw [hu]; exact Gen.refl one
      · right; rw [hw]; exact Gen.refl one
  have apart : ∀ x y, ¬Inv4 a b c d (basis x) (basis y) → ¬R4 a b c d (basis x) (basis y) :=
    fun x y hn h => hn (inv h)
  refine ⟨Gen.base, atom a (Or.inl rfl), atom b (Or.inr (Or.inl rfl)), atom c (Or.inr (Or.inr (Or.inl rfl))),
    atom d (Or.inr (Or.inr (Or.inr rfl))), ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
  · apply apart
    intro ⟨h1, h2, h3, h4, _⟩
    simp [basis, hab, hac, had, hbc, hbd, hcd, Ne.symm hab, Ne.symm hac, Ne.symm had, Ne.symm hbc,
      Ne.symm hbd, Ne.symm hcd] at h1 h2 h3 h4

end product_equation

/-- In the free monoid a product of two atoms has exactly one factorization. -/
theorem basis_pair_unique {i j k l : Nat} (h : mul (basis i) (basis j) = mul (basis k) (basis l)) :
    (i = k ∧ j = l) ∨ (i = l ∧ j = k) := by
  have hi := congrFun h i
  have hj := congrFun h j
  have hk := congrFun h k
  simp only [mul, basis] at hi hj hk
  by_cases e1 : i = k <;> by_cases e2 : i = l <;> by_cases e3 : j = k <;> by_cases e4 : j = l <;>
    by_cases e5 : i = j <;> by_cases e6 : k = l <;> simp_all <;> omega

end GodelCore
