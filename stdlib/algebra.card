module algebra

theorem cofactor_sum_1_to_n_sum_of_cubes(n: Nat) requires n <= 500: (n + n ** 2) * algorithm.sum_1_to_n(n) == (2) * algorithm.sum_of_cubes(n)
theorem compose_sum_of_cubes_of_sum_1_to_n(n: Nat) requires n <= 500: algorithm.sum_of_cubes(n) == (algorithm.sum_1_to_n(n)) ** 2
theorem cofactor_sum_1_to_n_sum_of_squares(n: Nat) requires n <= 500: (1 + 2 * n) * algorithm.sum_1_to_n(n) == (3) * algorithm.sum_of_squares(n)
theorem shift_triangular_sum_1_to_n(n: Nat) requires n >= 1, n <= 500: algorithm.triangular(n) == algorithm.sum_1_to_n(n - 1)
theorem cofactor_sum_of_cubes_sum_of_squares(n: Nat) requires n <= 500: (2 + 4 * n) * algorithm.sum_of_cubes(n) == (3 * n + 3 * n ** 2) * algorithm.sum_of_squares(n)
theorem cofactor_sum_of_cubes_triangular(n: Nat) requires n <= 500: (-2 + 2 * n) * algorithm.sum_of_cubes(n) == (n + 2 * n ** 2 + n ** 3) * algorithm.triangular(n)
theorem cofactor_sum_of_squares_triangular(n: Nat) requires n <= 500: (-3 + 3 * n) * algorithm.sum_of_squares(n) == (1 + 3 * n + 2 * n ** 2) * algorithm.triangular(n)
