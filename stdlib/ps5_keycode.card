-- libSceConvertKeycode's characters, derived: USB HID Usage Tables 1.12 section 10 (the Keyboard/Keypad page,
-- 0x07) read through the US layout, for the keys that produce a printable character (letters, digits,
-- punctuation, space, keypad); every other usage produces 0. us_char is what AnyPS5's sceConvertKeycodeGetCharacter
-- returns for the unshifted state (anyps5_semantics/keycode_us_layout runs it). us_shifted_char is the shifted
-- layer AnyPS5 does not implement (it throws for any state bit but 0x4000000): the characters are derived here;
-- which state bit means shift on the console is not, and stays an observation.
module ps5_keycode

fn us_char(k: Int) -> Int requires 0 <= k, k <= 0xFFFF {
  if 0x04 <= k and k <= 0x1D { return 97 + (k - 0x04) }
  if 0x1E <= k and k <= 0x26 { return 49 + (k - 0x1E) }
  if k == 0x27 { return 48 }
  if k == 0x2C { return 32 }
  if k == 0x2D { return 45 }
  if k == 0x2E { return 61 }
  if k == 0x2F { return 91 }
  if k == 0x30 { return 93 }
  if k == 0x31 { return 92 }
  if k == 0x33 { return 59 }
  if k == 0x34 { return 39 }
  if k == 0x35 { return 96 }
  if k == 0x36 { return 44 }
  if k == 0x37 { return 46 }
  if k == 0x38 { return 47 }
  if k == 0x54 { return 47 }
  if k == 0x55 { return 42 }
  if k == 0x56 { return 45 }
  if k == 0x57 { return 43 }
  if 0x59 <= k and k <= 0x61 { return 49 + (k - 0x59) }
  if k == 0x62 { return 48 }
  if k == 0x63 { return 46 }
  if k == 0x64 { return 92 }
  return 0
}
fn us_shifted_char(k: Int) -> Int requires 0 <= k, k <= 0xFFFF {
  if 0x04 <= k and k <= 0x1D { return 65 + (k - 0x04) }
  if k == 0x1E { return 33 }
  if k == 0x1F { return 64 }
  if k == 0x20 { return 35 }
  if k == 0x21 { return 36 }
  if k == 0x22 { return 37 }
  if k == 0x23 { return 94 }
  if k == 0x24 { return 38 }
  if k == 0x25 { return 42 }
  if k == 0x26 { return 40 }
  if k == 0x27 { return 41 }
  if k == 0x2D { return 95 }
  if k == 0x2E { return 43 }
  if k == 0x2F { return 123 }
  if k == 0x30 { return 125 }
  if k == 0x31 { return 124 }
  if k == 0x33 { return 58 }
  if k == 0x34 { return 34 }
  if k == 0x35 { return 126 }
  if k == 0x36 { return 60 }
  if k == 0x37 { return 62 }
  if k == 0x38 { return 63 }
  if k == 0x64 { return 124 }
  return us_char(k)
}
fn printable(c: Int) -> Bool = 32 <= c and c <= 126
-- the export's unshifted state: 0, or the bit AnyPS5 found titles pass and ignores (0x4000000)
fn us_char_state(k: Int, state: Int) -> Int requires 0 <= k, k <= 0xFFFF, state == 0 or state == 0x4000000 = us_char(k)

theorem keys_without_characters_stay_without(k: Int) requires 0 <= k, k <= 255: (us_char(k) == 0) <=> (us_shifted_char(k) == 0)
theorem characters_are_printable(k: Int) requires 0 <= k, k <= 255: us_char(k) == 0 or printable(us_char(k))
theorem shifted_characters_are_printable(k: Int) requires 0 <= k, k <= 255: us_shifted_char(k) == 0 or printable(us_shifted_char(k))
theorem shift_upcases_letters(k: Int) requires 4 <= k, k <= 29: us_shifted_char(k) == us_char(k) - 32
theorem shift_moves_every_main_key(k: Int) requires 4 <= k, k <= 0x38: us_char(k) == 0 or k == 0x2C or us_shifted_char(k) != us_char(k)
theorem keypad_ignores_shift(k: Int) requires 0x54 <= k, k <= 0x63: us_shifted_char(k) == us_char(k)

test us_char(0x04) == 97 and us_char(0x1D) == 122 and us_char(0x27) == 48 and us_char(0x28) == 0
test us_shifted_char(0x1E) == 33 and us_shifted_char(0x34) == 34 and us_shifted_char(0x2C) == 32
test us_char(0x58) == 0 and us_char(0x62) == 48 and us_char(0x32) == 0
