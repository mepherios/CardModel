-- The MPEG audio frame header, derived: ISO/IEC 11172-3 2.4.2.3 (MPEG-1), ISO/IEC 13818-3 (MPEG-2 lower sampling
-- frequencies) and the MPEG-2.5 extension (version bits 00, the MPEG-2 tables at half the rates). A header is
-- the four bytes h read big-endian. This is the core of libSceAjm's sceAjmDecMp3ParseFrame, which AnyPS5 takes
-- from shadPS4 (PS4) and documents as unconfirmed (docs/dev/debt/libSceAjm.native.md): it treats every layer as
-- layer III and accepts MPEG-2.5 only up to 64 kbit/s. anyps5_semantics/mp3_frame_header runs both of AnyPS5's
-- parsers next to these functions; where the standard and the export differ, the console decides (observation).
module ps5_mp3

fn mp3_version(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF = (h >> 19) & 3
fn mp3_layer(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF = 4 - ((h >> 17) & 3)
fn mp3_bitrate_index(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF = (h >> 12) & 15
fn mp3_rate_index(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF = (h >> 10) & 3
fn mp3_padding(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF = (h >> 9) & 1
fn mp3_channels(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF = if ((h >> 6) & 3) == 3 then 1 else 2

fn sample_rate(version: Int, i: Int) -> Int requires 0 <= version, version <= 3, 0 <= i, i <= 3 {
  if i == 3 or version == 1 { return 0 }
  let base = if i == 0 then 44100 else (if i == 1 then 48000 else 32000)
  if version == 3 { return base }
  if version == 2 { return base // 2 }
  return base // 4
}
-- kbit/s by (version, layer, index): MPEG-1 has its own table per layer, MPEG-2 and 2.5 share theirs;
-- 0 marks "free" (index 0) and "bad" (index 15)
fn kbps(version: Int, layer: Int, i: Int) -> Int requires 0 <= version, version <= 3, 1 <= layer, layer <= 3, 0 <= i, i <= 15 {
  let mpeg1 = version == 3
  if i == 0 or i == 15 { return 0 }
  if mpeg1 and layer == 1 { return 32 * i }
  if mpeg1 and layer == 2 {
    if i <= 2 { return 32 + 16 * (i - 1) }
    if i <= 4 { return 56 + 8 * (i - 3) }
    if i <= 8 { return 80 + 16 * (i - 5) }
    if i <= 12 { return 160 + 32 * (i - 9) }
    return 320 + 64 * (i - 13)
  }
  if mpeg1 {
    if i <= 5 { return 32 + 8 * (i - 1) }
    if i <= 9 { return 64 + 16 * (i - 5) }
    if i <= 13 { return 128 + 32 * (i - 9) }
    return 320
  }
  if layer == 1 {
    if i == 1 { return 32 }
    if i <= 4 { return 48 + 8 * (i - 2) }
    if i <= 12 { return 80 + 16 * (i - 5) }
    return 224 + 32 * (i - 13)
  }
  if i <= 8 { return 8 * i }
  return 64 + 16 * (i - 8)
}
fn valid_header(h: Int) -> Bool requires 0 <= h, h <= 0xFFFFFFFF =
  ((h >> 21) == 0x7FF and mp3_version(h) != 1 and ((h >> 17) & 3) != 0 and mp3_bitrate_index(h) != 0
   and mp3_bitrate_index(h) != 15 and mp3_rate_index(h) != 3)
fn bitrate(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF =
  1000 * kbps(mp3_version(h), mp3_layer(h), mp3_bitrate_index(h))
fn rate(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF = sample_rate(mp3_version(h), mp3_rate_index(h))
fn samples_per_frame(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF =
  if mp3_layer(h) == 1 then 384 else (if mp3_layer(h) == 2 or mp3_version(h) == 3 then 1152 else 576)
-- bytes in the frame, header included (layer I counts 4-byte slots)
fn frame_bytes(h: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF {
  if mp3_layer(h) == 1 { return (12 * bitrate(h) // rate(h) + mp3_padding(h)) * 4 }
  return samples_per_frame(h) // 8 * bitrate(h) // rate(h) + mp3_padding(h)
}

-- what a parser reports for header h: field 0 = frame bytes, 1 = channels, 2 = samples per frame, 3 = sample
-- rate, 4 = bitrate; -1 when the header is not a valid frame header
fn mp3_field(h: Int, f: Int) -> Int requires 0 <= h, h <= 0xFFFFFFFF, 0 <= f, f <= 4 {
  if not valid_header(h) { return -1 }
  if f == 0 { return frame_bytes(h) }
  if f == 1 { return mp3_channels(h) }
  if f == 2 { return samples_per_frame(h) }
  if f == 3 { return rate(h) }
  return bitrate(h)
}
fn layer3(h: Int) -> Bool requires 0 <= h, h <= 0xFFFFFFFF = ((h >> 17) & 3) == 1
-- where AnyPS5's export is meant to follow the standard, and where its debt entry says it does not
fn export_follows_standard(h: Int, f: Int) -> Bool requires 0 <= h, h <= 0xFFFFFFFF =
  layer3(h) and (mp3_version(h) != 0 or mp3_bitrate_index(h) <= 8)
fn export_documented_deviation(h: Int, f: Int) -> Bool requires 0 <= h, h <= 0xFFFFFFFF =
  valid_header(h) and (not layer3(h) or (mp3_version(h) == 0 and mp3_bitrate_index(h) >= 9))
fn decoder_scope(h: Int, f: Int) -> Bool requires 0 <= h, h <= 0xFFFFFFFF = layer3(h)

theorem frame_is_bitrate_over_rate(h: Int) requires 0xFFE00000 <= h, h <= 0xFFFFFFFF:
  (not valid_header(h) or mp3_layer(h) == 1
   or frame_bytes(h) * rate(h) <= samples_per_frame(h) // 8 * bitrate(h) + rate(h))
theorem mpeg25_is_mpeg2_halved(i: Int) requires 0 <= i, i <= 2: sample_rate(0, i) * 2 == sample_rate(2, i)
theorem layer3_lsf_tables_agree(i: Int) requires 0 <= i, i <= 15: kbps(2, 3, i) == kbps(2, 2, i) and kbps(0, 3, i) == kbps(2, 3, i)

test frame_bytes(0xFFFB9064) == 417 and bitrate(0xFFFB9064) == 128000 and rate(0xFFFB9064) == 44100
test frame_bytes(0xFFFB9264) == 418 and mp3_channels(0xFFFB90C4) == 1 and samples_per_frame(0xFFFB9064) == 1152
test kbps(3, 2, 14) == 384 and kbps(3, 1, 14) == 448 and kbps(2, 1, 14) == 256 and kbps(2, 3, 14) == 160
test kbps(3, 2, 1) == 32 and kbps(3, 2, 4) == 64 and kbps(3, 2, 8) == 128 and kbps(2, 1, 5) == 80
test rate(0xFFE39000) == 11025 and valid_header(0xFFE39000) and bitrate(0xFFE39000) == 80000
